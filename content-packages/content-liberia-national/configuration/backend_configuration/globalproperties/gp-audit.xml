<!--
  MOH ICT SOP control C1: audit logging of all clinical and admin actions.

  Read by the auditlog module (openmrs/openmrs-module-auditlog), which
  distribution/backend/Dockerfile builds from the commit pinned as source.auditlog.* in
  distribution/distro.properties. Without that module these properties configure nothing.

  ALL_EXCEPT audits every entity written through OpenMRS, which covers what the controls
  name: Patient, Person and its names/addresses/attributes, Encounter, Obs, Visit, Order,
  User, Role, Privilege, GlobalProperty (including liberiaemr.facility.locationUuid),
  Location, and report definitions (reporting stores them as SerializedObject).

  The exceptions:
  - org.openmrs.api.db.LoginCredential is CREDENTIAL MATERIAL. Audited, every password change
    or new user writes the old and new password hash and salt into auditlog_audit_log, where
    the audit reader, every backup and the binlog would hold them. Never remove it from the
    list. The cost: a password change leaves no audit row. User creation and every other
    change to a User are still recorded.
  - The OCL importer's own bookkeeping, one row per imported item. The concepts, names,
    mappings and drugs an import writes are still audited; only the importer's record of
    having processed them is not. On a first boot they were a quarter of all rows.

  KEEP auditlog.auditingStrategy ABOVE auditlog.exceptions. When the strategy is saved and the
  module has no cached strategy (every boot), its listener clears auditlog.exceptions; only a
  later save of the exceptions puts them back. Reversed, every boot would end with no
  exceptions, and password hashes would be audited.

  Writes that bypass Hibernate are not audited: direct SQL, Liquibase, the reporting ETL and
  the central sync receiver (which writes through its own JPA layer).
-->
<config>
  <globalProperties>
    <globalProperty>
      <property>auditlog.auditingStrategy</property>
      <value>ALL_EXCEPT</value>
      <description>Audit every entity type except those listed in auditlog.exceptions</description>
    </globalProperty>
    <globalProperty>
      <property>auditlog.exceptions</property>
      <value>org.openmrs.api.db.LoginCredential,org.openmrs.module.openconceptlab.Import,org.openmrs.module.openconceptlab.Item</value>
      <description>Credential material (password hashes and salts), and OCL importer bookkeeping</description>
    </globalProperty>
    <globalProperty>
      <property>auditlog.storeLastStateOfDeletedItems</property>
      <value>true</value>
      <description>Retain the final state of deleted records for investigation</description>
    </globalProperty>
  </globalProperties>
</config>
