<config>
  <globalProperties>
    <globalProperty>
      <property>security.passwordMinimumLength</property>
      <value>${var.security.password.minimum-length}</value>
      <description>Minimum password length (MOH ICT SOP: 13 characters)</description>
    </globalProperty>
    <globalProperty>
      <property>security.passwordRequiresUpperAndLowerCase</property>
      <value>true</value>
      <description>Password must mix upper and lower case</description>
    </globalProperty>
    <globalProperty>
      <property>security.passwordRequiresDigit</property>
      <value>true</value>
      <description>Password must contain a digit</description>
    </globalProperty>
    <globalProperty>
      <property>security.passwordRequiresNonDigit</property>
      <value>true</value>
      <description>Password must contain a non-digit</description>
    </globalProperty>
    <globalProperty>
      <property>security.passwordCannotMatchUsername</property>
      <value>true</value>
      <description>Password must not match the username or system id</description>
    </globalProperty>
    <globalProperty>
      <property>security.passwordCustomRegex</property>
      <value></value>
      <description>Left empty deliberately - a custom regex would override the rules above</description>
    </globalProperty>
    <globalProperty>
      <property>security.allowedFailedLoginsBeforeLockout</property>
      <value>${var.security.login.allowed-failures-before-lockout}</value>
      <description>OpenMRS 2.8.8 locks when attempts &gt; this value: 4 means lock on the fifth consecutive failure, not 5 (which would lock on failure 6).</description>
    </globalProperty>
    <globalProperty>
      <property>security.unlockAccountWaitingTime</property>
      <value>5</value>
      <description>Lockout recovery interval in minutes; preserves the existing 5-minute policy.</description>
    </globalProperty>
  </globalProperties>
</config>
