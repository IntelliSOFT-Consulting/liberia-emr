{
  "name": "TB Screening",
  "uuid": "${var.form.tb-screening.uuid}",
  "version": "1.0",
  "published": true,
  "retired": false,
  "encounter": "TB Screening",
  "pages": [
    {
      "label": "TB Screening",
      "sections": [
        {
          "label": "",
          "isExpanded": true,
          "questions": [
            {
              "label": "Contact of TB Patient",
              "id": "contact_of_tb_patient",
              "type": "obs",
              "required": true,
              "questionOptions": {
                "rendering": "radio",
                "concept": "${var.concept.national.contact-of-tb-patient.uuid}",
                "answers": [
                  {
                    "concept": "${var.concept.ciel.yes.uuid}",
                    "label": "Yes"
                  },
                  {
                    "concept": "${var.concept.ciel.no.uuid}",
                    "label": "No"
                  }
                ]
              }
            },
            {
              "label": "Previously Treated for TB",
              "id": "previously_treated_for_tb",
              "type": "obs",
              "required": true,
              "questionOptions": {
                "rendering": "radio",
                "concept": "${var.concept.national.previously-treated-for-tb.uuid}",
                "answers": [
                  {
                    "concept": "${var.concept.ciel.yes.uuid}",
                    "label": "Yes"
                  },
                  {
                    "concept": "${var.concept.ciel.no.uuid}",
                    "label": "No"
                  }
                ]
              }
            },
            {
              "label": "Date TB treatment was started for the person screened, if applicable",
              "id": "date_tb_treatment_was_started",
              "type": "obs",
              "required": {
                "type": "conditionalRequired",
                "message": "Date TB treatment was started is required if previously treated for TB",
                "referenceQuestionId": "previously_treated_for_tb",
                "referenceQuestionAnswers": [
                  "${var.concept.ciel.yes.uuid}"
                ]
              },
              "hide": {
                "hideWhenExpression": "previously_treated_for_tb !== '${var.concept.ciel.yes.uuid}'"
              },
              "questionOptions": {
                "rendering": "date",
                "concept": "${var.concept.ciel.date-tb-treatment-was-started.uuid}"
              },
              "validators": [
                {
                  "type": "date",
                  "allowFutureDates": "false"
                },
                {
                  "type": "js_expression",
                  "failsWhenExpression": "!isEmpty(myValue) && calcAgeBasedOnDate(myValue) < 0",
                  "message": "Date cannot be before the patient's date of birth."
                }
              ]
            },
            {
              "label": "Coughing 2 Weeks or More",
              "id": "coughing_2_weeks_or_more",
              "type": "obs",
              "required": true,
              "questionOptions": {
                "rendering": "radio",
                "concept": "${var.concept.national.coughing-2-weeks-or-more.uuid}",
                "answers": [
                  {
                    "concept": "${var.concept.ciel.yes.uuid}",
                    "label": "Yes"
                  },
                  {
                    "concept": "${var.concept.ciel.no.uuid}",
                    "label": "No"
                  }
                ]
              }
            },
            {
              "label": "Night Sweats",
              "id": "night_sweats",
              "type": "obs",
              "required": true,
              "questionOptions": {
                "rendering": "radio",
                "concept": "${var.concept.national.night-sweats.uuid}",
                "answers": [
                  {
                    "concept": "${var.concept.ciel.yes.uuid}",
                    "label": "Yes"
                  },
                  {
                    "concept": "${var.concept.ciel.no.uuid}",
                    "label": "No"
                  }
                ]
              }
            },
            {
              "label": "Weight Loss",
              "id": "weight_loss",
              "type": "obs",
              "required": true,
              "questionOptions": {
                "rendering": "radio",
                "concept": "${var.concept.national.weight-loss.uuid}",
                "answers": [
                  {
                    "concept": "${var.concept.ciel.yes.uuid}",
                    "label": "Yes"
                  },
                  {
                    "concept": "${var.concept.ciel.no.uuid}",
                    "label": "No"
                  }
                ]
              }
            },
            {
              "label": "Fever",
              "id": "fever",
              "type": "obs",
              "required": true,
              "questionOptions": {
                "rendering": "radio",
                "concept": "${var.concept.national.fever.uuid}",
                "answers": [
                  {
                    "concept": "${var.concept.ciel.yes.uuid}",
                    "label": "Yes"
                  },
                  {
                    "concept": "${var.concept.ciel.no.uuid}",
                    "label": "No"
                  }
                ]
              }
            },
            {
              "label": "Swelling in Any Part of the Body",
              "id": "swelling_in_any_part_of_the_body",
              "type": "obs",
              "required": true,
              "questionOptions": {
                "rendering": "radio",
                "concept": "${var.concept.national.swelling-in-any-part-of-the-body.uuid}",
                "answers": [
                  {
                    "concept": "${var.concept.ciel.yes.uuid}",
                    "label": "Yes"
                  },
                  {
                    "concept": "${var.concept.ciel.no.uuid}",
                    "label": "No"
                  }
                ]
              }
            },
            {
              "label": "Total Score",
              "id": "total_score",
              "type": "obs",
              "behaviours": [
                {
                  "intent": "*",
                  "readonly": true
                }
              ],
              "questionOptions": {
                "rendering": "number",
                "disallowDecimals": true,
                "step": "1",
                "min": "0",
                "max": "6",
                "concept": "${var.concept.national.total-score.uuid}",
                "calculate": {
                  "calculateExpression": "(coughing_2_weeks_or_more === '${var.concept.ciel.yes.uuid}' ? 2 : 0) + (night_sweats === '${var.concept.ciel.yes.uuid}' ? 1 : 0) + (weight_loss === '${var.concept.ciel.yes.uuid}' ? 1 : 0) + (fever === '${var.concept.ciel.yes.uuid}' ? 1 : 0) + (swelling_in_any_part_of_the_body === '${var.concept.ciel.yes.uuid}' ? 1 : 0)"
                }
              },
              "validators": [
                {
                  "type": "js_expression",
                  "failsWhenExpression": "!isEmpty(myValue) && (myValue < 0 || myValue > 6)",
                  "message": "Total score must be between 0 and 6"
                }
              ]
            },
            {
              "label": "Date the screening was conducted",
              "id": "date_the_screening_was_conducted",
              "type": "obs",
              "required": true,
              "questionOptions": {
                "rendering": "date",
                "concept": "${var.concept.national.date-the-screening-was-conducted.uuid}"
              },
              "validators": [
                {
                  "type": "date",
                  "allowFutureDates": "false"
                },
                {
                  "type": "js_expression",
                  "failsWhenExpression": "!isEmpty(myValue) && calcAgeBasedOnDate(myValue) < 0",
                  "message": "Date cannot be before the patient's date of birth."
                }
              ]
            },
            {
              "label": "Result of the sputum test or other diagnostic evaluation",
              "id": "result_of_the_sputum_test_or_other_diagnostic_evaluation",
              "type": "obs",
              "required": true,
              "questionOptions": {
                "rendering": "text",
                "concept": "${var.concept.national.result-of-the-sputum-test-or-other-diagnostic-evaluation.uuid}"
              }
            },
            {
              "label": "Observation",
              "id": "observation",
              "type": "obs",
              "required": true,
              "questionOptions": {
                "rendering": "textarea",
                "concept": "${var.concept.ciel.comments.uuid}"
              }
            }
          ]
        }
      ]
    }
  ],
  "processor": "EncounterFormProcessor",
  "referencedForms": []
}