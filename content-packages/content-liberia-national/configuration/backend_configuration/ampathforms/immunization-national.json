{
  "name": "Immunization",
  "uuid": "${var.form.immunization.uuid}",
  "version": "1.7",
  "published": true,
  "retired": false,
  "processor": "EncounterFormProcessor",
  "encounter": "Consultation",
  "pages": [
    {
      "label": "Vaccination",
      "sections": [
        {
          "label": "Notice",
          "isExpanded": true,
          "hide": {
            "hideWhenExpression": "age < 18"
          },
          "questions": [
            {
              "type": "markdown",
              "questionOptions": {
                "rendering": "markdown"
              },
              "id": "age_restriction_notice",
              "value": [
                "**Childhood vaccines on this form are for children aged 18 and below.** Tetanus-diphtheria (Td) can be recorded at any age, and only during a confirmed pregnancy."
              ]
            }
          ]
        },
        {
          "label": "Vaccination",
          "isExpanded": true,
          "questions": [
            {
              "id": "tdEncounterDate",
              "label": "Encounter Date",
              "type": "encounterDatetime",
              "questionOptions": {
                "rendering": "date"
              },
              "hide": {
                "hideWhenExpression": "true"
              }
            },
            {
              "label": "Parent/Caregiver",
              "type": "obs",
              "id": "parent_caregiver",
              "hide": {
                "hideWhenExpression": "age > 18"
              },
              "questionOptions": {
                "concept": "${var.concept.national.parent-caregiver.uuid}",
                "rendering": "text"
              }
            },
            {
              "label": "Caregiver Phone Number",
              "type": "obs",
              "id": "caregiver_phone_number",
              "hide": {
                "hideWhenExpression": "age > 18"
              },
              "questionOptions": {
                "concept": "${var.concept.national.caregiver-phone-number.uuid}",
                "rendering": "text"
              },
              "validators": [
                {
                  "type": "js_expression",
                  "failsWhenExpression": "!isEmpty(myValue) && doesNotMatchExpression('^\\\\+?(?=(?:[ ()\\\\-]*\\\\d){7,15}[ ()\\\\-]*$)[\\\\d ()\\\\-]+$', myValue)",
                  "message": "Enter a valid phone number."
                }
              ]
            },
            {
              "label": "Td eligibility",
              "type": "obs",
              "id": "td_gate",
              "hide": {
                "hideWhenExpression": "true"
              },
              "questionOptions": {
                "rendering": "text",
                "isTransient": true,
                "calculate": {
                  "calculateExpression": "tdAdministrationGate(patient.id, patient.birthDate, tdEncounterDate, vaccine_name, vitaminAEditingEncounterUuid(), '${var.concept.ciel.pregnancy-status.uuid}', '${var.concept.national.1st-trimester.uuid}', '${var.concept.national.2nd-trimester.uuid}', '${var.concept.national.3rd-trimester.uuid}', '${var.concept.national.vaccine-name.uuid}', '${var.concept.national.td.uuid}', '${var.concept.national.date-of-tt1.uuid}', '${var.concept.national.td2.uuid}', '${var.concept.national.date-of-tt2.uuid}', '${var.concept.national.td3.uuid}', '${var.concept.national.date-of-tt3.uuid}', '${var.concept.national.td4.uuid}', '${var.concept.national.date-of-tt4.uuid}', '${var.concept.national.td5.uuid}', '${var.concept.national.date-of-tt5.uuid}').then(code => code)"
                }
              }
            },
            {
              "label": "Vaccine Name",
              "type": "obs",
              "id": "vaccine_name",
              "questionOptions": {
                "concept": "${var.concept.national.vaccine-name.uuid}",
                "rendering": "select",
                "answers": [
                  {
                    "concept": "${var.concept.national.bcg.uuid}",
                    "label": "BCG",
                    "hide": {
                      "hideWhenExpression": "age >= 1"
                    }
                  },
                  {
                    "concept": "${var.concept.national.opv0-1-dose.uuid}",
                    "label": "OPV0",
                    "hide": {
                      "hideWhenExpression": "age > 18"
                    }
                  },
                  {
                    "concept": "${var.concept.national.opv1.uuid}",
                    "label": "OPV1",
                    "hide": {
                      "hideWhenExpression": "age > 18"
                    }
                  },
                  {
                    "concept": "${var.concept.national.td.uuid}",
                    "label": "TD"
                  },
                  {
                    "concept": "${var.concept.national.td2.uuid}",
                    "label": "TD2"
                  },
                  {
                    "concept": "${var.concept.national.td3.uuid}",
                    "label": "TD3"
                  },
                  {
                    "concept": "${var.concept.national.td4.uuid}",
                    "label": "TD4"
                  },
                  {
                    "concept": "${var.concept.national.td5.uuid}",
                    "label": "TD5"
                  }
                ]
              },
              "validators": [
                {
                  "type": "js_expression",
                  "failsWhenExpression": "isTdVaccine(myValue, '${var.concept.national.td.uuid}', '${var.concept.national.td2.uuid}', '${var.concept.national.td3.uuid}', '${var.concept.national.td4.uuid}', '${var.concept.national.td5.uuid}') && (isEmpty(td_gate) || td_gate === 'unresolved')",
                  "message": "Td cannot be given because pregnancy status or tetanus history could not be checked."
                },
                {
                  "type": "js_expression",
                  "failsWhenExpression": "isTdVaccine(myValue, '${var.concept.national.td.uuid}', '${var.concept.national.td2.uuid}', '${var.concept.national.td3.uuid}', '${var.concept.national.td4.uuid}', '${var.concept.national.td5.uuid}') && td_gate === 'unknown-pregnancy'",
                  "message": "Confirm the current pregnancy before giving Td. Pregnancy status is not recorded."
                },
                {
                  "type": "js_expression",
                  "failsWhenExpression": "isTdVaccine(myValue, '${var.concept.national.td.uuid}', '${var.concept.national.td2.uuid}', '${var.concept.national.td3.uuid}', '${var.concept.national.td4.uuid}', '${var.concept.national.td5.uuid}') && td_gate === 'history-conflict'",
                  "message": "Td cannot be given because the TT and Td dates for the same dose do not match."
                },
                {
                  "type": "js_expression",
                  "failsWhenExpression": "isTdVaccine(myValue, '${var.concept.national.td.uuid}', '${var.concept.national.td2.uuid}', '${var.concept.national.td3.uuid}', '${var.concept.national.td4.uuid}', '${var.concept.national.td5.uuid}') && td_gate === 'already-given'",
                  "message": "This Td dose is already recorded."
                },
                {
                  "type": "js_expression",
                  "failsWhenExpression": "isTdVaccine(myValue, '${var.concept.national.td.uuid}', '${var.concept.national.td2.uuid}', '${var.concept.national.td3.uuid}', '${var.concept.national.td4.uuid}', '${var.concept.national.td5.uuid}') && td_gate === 'too-soon'",
                  "message": "This Td dose is not due yet. The previous tetanus dose and the required interval have not been met."
                }
              ]
            },
            {
              "label": "Route",
              "type": "obs",
              "id": "route",
              "questionOptions": {
                "concept": "${var.concept.national.route.uuid}",
                "rendering": "select",
                "answers": [
                  {
                    "concept": "${var.concept.ciel.oral.uuid}",
                    "label": "Oral"
                  }
                ],
                "calculate": {
                  "calculateExpression": "vitaminARouteValue(vaccine_name, supp_activities, myValue, '${var.concept.ciel.oral.uuid}')"
                }
              },
              "validators": [
                {
                  "type": "js_expression",
                  "failsWhenExpression": "vitaminARouteRejected(vaccine_name, supp_activities, myValue, '${var.concept.ciel.oral.uuid}')",
                  "message": "Vitamin A is given orally."
                }
              ]
            },
            {
              "label": "Return date for the next vaccination",
              "type": "obs",
              "id": "return_date",
              "questionOptions": {
                "concept": "${var.concept.national.return-date-for-the-next-vaccination.uuid}",
                "rendering": "date",
                "calculate": {
                  "calculateExpression": "vitaminASharedReturnValue(vaccine_name, patient.birthDate, vitamin_a_date_received, supp_activities, '${var.concept.national.vit-a-blue-100-000iu.uuid}', '${var.concept.national.vit-a-red-200-000iu.uuid}', today(), myValue)"
                }
              },
              "validators": [
                {
                  "type": "js_expression",
                  "failsWhenExpression": "!isEmpty(myValue) && !isDateAfterSimple(myValue, today())",
                  "message": "Return date must be a future date."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Supplementary Immunization",
      "sections": [
        {
          "label": "Supplementary Immunization",
          "isExpanded": true,
          "hide": {
            "hideWhenExpression": "age > 18"
          },
          "questions": [
            {
              "id": "encounterDate",
              "label": "Encounter Date",
              "type": "encounterDatetime",
              "questionOptions": {
                "rendering": "date"
              },
              "hide": {
                "hideWhenExpression": "true"
              }
            },
            {
              "label": "Vitamin A administration history",
              "type": "obs",
              "id": "vitamin_a_history",
              "hide": {
                "hideWhenExpression": "true"
              },
              "questionOptions": {
                "rendering": "text",
                "isTransient": true,
                "calculate": {
                  "calculateExpression": "loadVitaminAAdministrations(patient.id, '${var.concept.national.supplementary-immunization-activities.uuid}', '${var.concept.national.date-received.uuid}', '${var.concept.national.vit-a-blue-100-000iu.uuid}', '${var.concept.national.vit-a-red-200-000iu.uuid}').then(v => v)"
                }
              }
            },
            {
              "label": "Supplementary immunization activities",
              "type": "obs",
              "id": "supp_activities",
              "questionOptions": {
                "concept": "${var.concept.national.supplementary-immunization-activities.uuid}",
                "rendering": "select",
                "answers": [
                  {
                    "concept": "${var.concept.national.vit-a-blue-100-000iu.uuid}",
                    "label": "Vit.-A.Blue 100,000iu",
                    "hide": {
                      "hideWhenExpression": "vitaminACurrentStrength(patient.birthDate, encounterDate) !== 'blue'"
                    }
                  },
                  {
                    "concept": "${var.concept.national.vit-a-red-200-000iu.uuid}",
                    "label": "Vit.-A.Red 200,000iu",
                    "hide": {
                      "hideWhenExpression": "vitaminACurrentStrength(patient.birthDate, encounterDate) !== 'red'"
                    }
                  }
                ]
              },
              "validators": [
                {
                  "type": "js_expression",
                  "failsWhenExpression": "vitaminABlock(patient.birthDate, encounterDate, vitamin_a_date_received, myValue, vitamin_a_history, '${var.concept.national.vit-a-blue-100-000iu.uuid}', '${var.concept.national.vit-a-red-200-000iu.uuid}', mode, vitaminAEditingEncounterUuid()) === 'age'",
                  "message": "Vitamin A strength does not match this child's age. Blue 100,000 IU is for 6-11 months and Red 200,000 IU is for 12-59 months. A missed colour is not given after the child leaves that age band."
                },
                {
                  "type": "js_expression",
                  "failsWhenExpression": "vitaminABlock(patient.birthDate, encounterDate, vitamin_a_date_received, myValue, vitamin_a_history, '${var.concept.national.vit-a-blue-100-000iu.uuid}', '${var.concept.national.vit-a-red-200-000iu.uuid}', mode, vitaminAEditingEncounterUuid()) === 'blue-repeat'",
                  "message": "Vitamin A Blue can be given only once from the 6-month birthday until the 12-month birthday."
                },
                {
                  "type": "js_expression",
                  "failsWhenExpression": "vitaminABlock(patient.birthDate, encounterDate, vitamin_a_date_received, myValue, vitamin_a_history, '${var.concept.national.vit-a-blue-100-000iu.uuid}', '${var.concept.national.vit-a-red-200-000iu.uuid}', mode, vitaminAEditingEncounterUuid()) === 'minimum-interval'",
                  "message": "Vitamin A cannot be given until 30 days after the previous dose."
                },
                {
                  "type": "js_expression",
                  "failsWhenExpression": "vitaminABlock(patient.birthDate, encounterDate, vitamin_a_date_received, myValue, vitamin_a_history, '${var.concept.national.vit-a-blue-100-000iu.uuid}', '${var.concept.national.vit-a-red-200-000iu.uuid}', mode, vitaminAEditingEncounterUuid()) === 'history'",
                  "message": "Vitamin A history could not be confirmed, so this dose cannot be saved."
                },
                {
                  "type": "js_expression",
                  "failsWhenExpression": "vitaminABlock(patient.birthDate, encounterDate, vitamin_a_date_received, myValue, vitamin_a_history, '${var.concept.national.vit-a-blue-100-000iu.uuid}', '${var.concept.national.vit-a-red-200-000iu.uuid}', mode, vitaminAEditingEncounterUuid()) === 'strength'",
                  "message": "Select the Vitamin A strength."
                }
              ]
            },
            {
              "label": "Date received",
              "type": "obs",
              "id": "vitamin_a_date_received",
              "questionOptions": {
                "concept": "${var.concept.national.date-received.uuid}",
                "rendering": "date"
              },
              "validators": [
                {
                  "type": "date",
                  "allowFutureDates": "false"
                },
                {
                  "type": "js_expression",
                  "failsWhenExpression": "!isEmpty(supp_activities) && isEmpty(myValue)",
                  "message": "Date received is required for Vitamin A."
                },
                {
                  "type": "js_expression",
                  "failsWhenExpression": "!isEmpty(supp_activities) && !isEmpty(myValue) && vitaminABlock(patient.birthDate, encounterDate, myValue, supp_activities, vitamin_a_history, '${var.concept.national.vit-a-blue-100-000iu.uuid}', '${var.concept.national.vit-a-red-200-000iu.uuid}', mode, vitaminAEditingEncounterUuid()) !== ''",
                  "message": "This Vitamin A dose cannot be recorded on this date."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
