{
  "_comment": [
    "MOH-wide O3 runtime configuration. Loaded after config-core.json and before the",
    "programme and site layers, so it overrides core and is overridden by site.",
    "Must be listed in SPA_CONFIG_URLS — see IMPLEMENTATION.md §7."
  ],
  "_comment_service_queues": [
    "concepts MUST be set. Every key below has a built-in default in",
    "esm-service-queues-app pointing at a RefApp demo concept that does not exist in this",
    "database, and the app sends those UUIDs straight to the backend — queue-entry?status=",
    "<uuid> then answers 500 'Unable to find concept' and the dashboard renders an error.",
    "Leaving the block empty is NOT the same as leaving it unset: the defaults still apply."
  ],
  "@openmrs/esm-service-queues-app": {
    "defaultInitialServiceQueue": "TB Screening",
    "concepts": {
      "defaultStatusConceptUuid": "${var.concept.ciel.queue-waiting.uuid}",
      "defaultTransitionStatus": "${var.concept.ciel.queue-in-progress.uuid}",
      "defaultPriorityConceptUuid": "${var.concept.national.queue-routine.uuid}",
      "emergencyPriorityConceptUuid": "${var.concept.ciel.queue-emergency.uuid}"
    }
  },
  "@openmrs/esm-patient-registration-app": {
    "defaultPatientIdentifierTypes": [
      "${var.identifiertype.moh-health-record.uuid}",
      "${var.identifiertype.national-id.uuid}"
    ],
    "sections": [
      "demographics",
      "contact",
      "referralDetails",
      "relationships"
    ],
    "sectionDefinitions": [
      {
        "id": "referralDetails",
        "name": "Referral Details",
        "fields": [
          "purposeOfVisit",
          "referredFrom",
          "referredBy",
          "referralRefNumber",
          "dateOfReferral",
          "reasonForReferral"
        ]
      }
    ],
    "fieldDefinitions": [
      {
        "id": "purposeOfVisit",
        "type": "person attribute",
        "uuid": "${var.personattribute.purpose-of-visit.uuid}",
        "label": "Purpose of Visit",
        "placeholder": "Purpose of Visit"
      },
      {
        "id": "referredFrom",
        "type": "person attribute",
        "uuid": "${var.personattribute.referred-from.uuid}",
        "label": "Referred from",
        "placeholder": "Referred from details"
      },
      {
        "id": "referredBy",
        "type": "person attribute",
        "uuid": "${var.personattribute.referred-by.uuid}",
        "label": "Referred by",
        "placeholder": "Referred by"
      },
      {
        "id": "referralRefNumber",
        "type": "person attribute",
        "uuid": "${var.personattribute.referral-ref-number.uuid}",
        "label": "Referral reference number",
        "placeholder": "1234567"
      },
      {
        "id": "dateOfReferral",
        "type": "obs",
        "uuid": "${var.concept.date-of-referral.uuid}",
        "label": "Date of Referral",
        "placeholder": "Select Date",
        "validation": {
          "required": false
        }
      },
      {
        "id": "reasonForReferral",
        "type": "person attribute",
        "uuid": "${var.personattribute.reason-for-referral.uuid}",
        "label": "Reason for referral",
        "placeholder": "Reason for referral"
      }
    ],
    "fieldConfigurations": {
      "name": {
        "displayMiddleName": true
      },
      "address": {
        "useAddressHierarchy": {
          "enabled": true,
          "useQuickSearch": true,
          "searchAddressByLevel": true
        }
      },
      "gender": [
        {
          "value": "male",
          "label": "Male"
        },
        {
          "value": "female",
          "label": "Female"
        }
      ]
    }
  },
  "@openmrs/esm-primary-navigation-app": {
    "_comment_timeout": [
      "MOH ICT SOP: 10-minute inactivity timeout. This client-side timer is HALF the",
      "control — it ends the user's session in the browser but does not invalidate a",
      "stolen server session. The matching server-side timeout is configured in the",
      "backend image; both must be present. See the globalproperties/README.md table."
    ],
    "logoutIdleTimeoutMinutes": "${var.security.session.timeout-minutes}"
  },
  "@openmrs/esm-styleguide": {
    "Brand color #1": "#002A86",
    "Brand color #2": "#001B56",
    "Brand color #3": "#002A86"
  },
  "@openmrs/esm-patient-forms-app": {
    "orderBy": "most-recent",
    "formSections": [
      {
        "name": "TB Forms",
        "forms": [
          "TB Screening"
        ]
      },
      {
        "name": "Triage",
        "forms": [
          "Triage Form",
          "OPD Consultation Form"
        ]
      },
      {
        "name": "Maternal and Child Health",
        "forms": [
          "ANC Initial Visit",
          "ANC Follow-up Visit",
          "Labour and Delivery Form",
          "Delivery Summary",
          "Newborn PNC",
          "Family Planning"
        ]
      },
      {
        "name": "Immunization",
        "forms": [
          "Immunization",
          "Adverse Event Following Immunization (AEFI)"
        ]
      }
    ]
  },
  "@openmrs/esm-billing-app": {
    "defaultCurrency": "LRD"
  }
}