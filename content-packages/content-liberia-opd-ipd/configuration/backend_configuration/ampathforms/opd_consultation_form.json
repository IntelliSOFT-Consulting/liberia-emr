{
    "name": "OPD Consultation Form",
    "uuid": "96b72a44-f8b8-472e-8d8d-327c73708eeb",
    "version": "2.0",
    "published": true,
    "retired": false,
    "encounter": "Consultation",
    "processor": "EncounterFormProcessor",
    "formOptions": {
        "usePreviousValueDisabled": false
    },
    "pages": [
        {
            "label": "Patient Category",
            "sections": [
                {
                    "label": "Patient Category",
                    "isExpanded": "true",
                    "questions": [
                        {
                            "id": "patientCategory",
                            "label": "Patient Category",
                            "type": "obs",
                            "required": true,
                            "questionOptions": {
                                "rendering": "select",
                                "concept": "${var.concept.visit-type-opd.uuid}",
                                "answers": [
                                    {
                                        "concept": "${var.concept.visit-type-opd-new.uuid}",
                                        "label": "First Visit"
                                    },
                                    {
                                        "concept": "${var.concept.visit-type-opd-followup.uuid}",
                                        "label": "Follow-up Visit"
                                    },
                                    {
                                        "concept": "${var.concept.visit-type-opd-referral.uuid}",
                                        "label": "Referral"
                                    }
                                ]
                            }
                        },
                        {
                            "id": "encounterProvider",
                            "label": "Attending Clinician",
                            "type": "encounterProvider",
                            "required": true,
                            "questionOptions": {
                                "rendering": "ui-select-extended"
                            }
                        },
                        {
                            "id": "encounterLocation",
                            "label": "Encounter Location",
                            "type": "encounterLocation",
                            "required": true,
                            "questionOptions": {
                                "rendering": "ui-select-extended"
                            }
                        },
                        {
                            "id": "encounterDate",
                            "label": "Encounter Date",
                            "type": "encounterDatetime",
                            "required": true,
                            "questionOptions": {
                                "rendering": "date"
                            },
                            "validators": [
                                {
                                    "type": "date",
                                    "allowFutureDates": "false"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "label": "Vitals",
            "sections": [
                {
                    "label": "Vitals",
                    "isExpanded": "true",
                    "questions": [
                        {
                            "id": "presentingComplaint",
                            "label": "Presenting Complaint",
                            "type": "obs",
                            "required": true,
                            "questionOptions": {
                                "rendering": "textarea",
                                "concept": "${var.concept.ciel.presenting-complaint.uuid}",
                                "rows": 3,
                                "max": 100
                            }
                        },
                        {
                            "id": "hpc",
                            "label": "History of Presenting Complaint",
                            "type": "obs",
                            "questionOptions": {
                                "rendering": "textarea",
                                "concept": "${var.concept.ciel.history-presenting-complaint.uuid}",
                                "rows": 3,
                                "max": 100
                            }
                        },
                        {
                            "id": "pmh",
                            "label": "Past Medical History",
                            "type": "obs",
                            "questionOptions": {
                                "rendering": "textarea",
                                "concept": "${var.concept.ciel.past-medical-history.uuid}",
                                "rows": 3,
                                "max": 100
                            }
                        },
                        {
                            "id": "temperature",
                            "label": "Temperature (°C)",
                            "type": "obs",
                            "questionOptions": {
                                "rendering": "number",
                                "concept": "${var.concept.ciel.temp.uuid}",
                                "min": "25",
                                "max": "43",
                                "step": 0.1
                            },
                            "validators": [
                                {
                                    "type": "js_expression",
                                    "failsWhenExpression": "myValue < 25 || myValue > 43",
                                    "message": "Temperature must be between 25 and 43 °C."
                                },
                                {
                                    "type": "js_expression",
                                    "warnsWhenExpression": "myValue < 35 || myValue > 39",
                                    "message": "Temperature is outside the normal range (35–39 °C). Please verify the reading."
                                }
                            ]
                        },
                        {
                            "id": "pulse",
                            "label": "Pulse/Heart Rate (beats/min)",
                            "type": "obs",
                            "questionOptions": {
                                "rendering": "number",
                                "concept": "${var.concept.ciel.pulse.uuid}",
                                "min": "0",
                                "max": "230",
                                "step": 1,
                                "disallowDecimals": true
                            },
                            "validators": [
                                {
                                    "type": "js_expression",
                                    "failsWhenExpression": "myValue < 0 || myValue > 230",
                                    "message": "Pulse/Heart Rate must be between 0 and 230 beats/min."
                                },
                                {
                                    "type": "js_expression",
                                    "warnsWhenExpression": "myValue < 55 || myValue > 100",
                                    "message": "Pulse is outside the normal range (55–100 beats/min). Please verify the reading."
                                }
                            ]
                        },
                        {
                            "id": "respiratoryRate",
                            "label": "Respiratory Rate (breaths/min)",
                            "type": "obs",
                            "questionOptions": {
                                "rendering": "number",
                                "concept": "${var.concept.ciel.rr.uuid}",
                                "min": "0",
                                "max": "80",
                                "step": 1,
                                "disallowDecimals": true
                            },
                            "validators": [
                                {
                                    "type": "js_expression",
                                    "failsWhenExpression": "myValue < 0 || myValue > 80",
                                    "message": "Respiratory Rate must be between 0 and 80 breaths/min."
                                },
                                {
                                    "type": "js_expression",
                                    "warnsWhenExpression": "myValue < 12 || myValue > 26",
                                    "message": "Respiratory Rate is outside the normal range (12–26 breaths/min). Please verify the reading."
                                }
                            ]
                        },
                        {
                            "id": "systolic",
                            "label": "Systolic Blood Pressure (mmHg)",
                            "type": "obs",
                            "questionOptions": {
                                "rendering": "number",
                                "concept": "${var.concept.ciel.systolic.uuid}",
                                "min": "0",
                                "max": "250",
                                "step": 1,
                                "disallowDecimals": true
                            },
                            "validators": [
                                {
                                    "type": "js_expression",
                                    "failsWhenExpression": "myValue < 0 || myValue > 250",
                                    "message": "Systolic Blood Pressure must be between 0 and 250 mmHg."
                                },
                                {
                                    "type": "js_expression",
                                    "warnsWhenExpression": "myValue < 100 || myValue > 140",
                                    "message": "Systolic BP is outside the normal range (100–140 mmHg). Please verify the reading."
                                }
                            ]
                        },
                        {
                            "id": "diastolic",
                            "label": "Diastolic Blood Pressure (mmHg)",
                            "type": "obs",
                            "questionOptions": {
                                "rendering": "number",
                                "concept": "${var.concept.ciel.diastolic.uuid}",
                                "min": "0",
                                "max": "150",
                                "step": 1,
                                "disallowDecimals": true
                            },
                            "validators": [
                                {
                                    "type": "js_expression",
                                    "failsWhenExpression": "myValue < 0 || myValue > 150",
                                    "message": "Diastolic Blood Pressure must be between 0 and 150 mmHg."
                                },
                                {
                                    "type": "js_expression",
                                    "failsWhenExpression": "!isEmpty(systolic) && myValue >= systolic",
                                    "message": "Diastolic pressure cannot be greater than or equal to systolic pressure."
                                },
                                {
                                    "type": "js_expression",
                                    "warnsWhenExpression": "myValue < 55 || myValue > 90",
                                    "message": "Diastolic BP is outside the normal range (55–90 mmHg). Please verify the reading."
                                }
                            ]
                        },
                        {
                            "id": "spo2",
                            "label": "Oxygen Saturation — SpO₂ (%)",
                            "type": "obs",
                            "questionOptions": {
                                "rendering": "number",
                                "concept": "${var.concept.ciel.spo2.uuid}",
                                "min": "0",
                                "max": "100",
                                "step": 1,
                                "disallowDecimals": true
                            },
                            "validators": [
                                {
                                    "type": "js_expression",
                                    "failsWhenExpression": "myValue < 0 || myValue > 100",
                                    "message": "Oxygen Saturation (SpO₂) must be between 0 and 100%."
                                },
                                {
                                    "type": "js_expression",
                                    "warnsWhenExpression": "myValue < 95",
                                    "message": "SpO₂ below 95% — please verify the reading and consider clinical review."
                                }
                            ]
                        },
                        {
                            "id": "weight",
                            "label": "Weight (kg)",
                            "type": "obs",
                            "questionOptions": {
                                "rendering": "number",
                                "concept": "${var.concept.ciel.weight.uuid}",
                                "min": "0",
                                "max": "250",
                                "step": 0.1
                            },
                            "validators": [
                                {
                                    "type": "js_expression",
                                    "failsWhenExpression": "myValue < 0 || myValue > 250",
                                    "message": "Weight must be between 0 and 250 kg."
                                }
                            ]
                        },
                        {
                            "id": "height",
                            "label": "Height/Length (cm)",
                            "type": "obs",
                            "questionOptions": {
                                "rendering": "number",
                                "concept": "${var.concept.ciel.height.uuid}",
                                "min": "10",
                                "max": "272",
                                "step": 0.1
                            },
                            "validators": [
                                {
                                    "type": "js_expression",
                                    "failsWhenExpression": "myValue < 10 || myValue > 272",
                                    "message": "Height/Length must be between 10 and 272 cm."
                                }
                            ]
                        },
                        {
                            "id": "bmi",
                            "label": "BMI",
                            "type": "obs",
                            "isDisabled": true,
                            "questionOptions": {
                                "rendering": "number",
                                "concept": "${var.concept.ciel.bmi.uuid}",
                                "disallowDecimals": false,
                                "calculate": {
                                    "calculateExpression": "calcBMI(height, weight)"
                                }
                            },
                            "disabled": {
                                "disableWhenExpression": "true"
                            }
                        }
                    ]
                }
            ]
        },
