                                "concept": "${var.concept.advice-non-pharmacological.uuid}",
                                "rows": 3,
                                "max": 100
                            }
                        },
                        {
                            "id": "followupRequired",
                            "label": "Follow-up Required?",
                            "type": "obs",
                            "questionOptions": {
                                "rendering": "radio",
                                "concept": "${var.concept.followup-required.uuid}",
                                "answers": [
                                    {
                                        "concept": "${var.concept.ciel.yes.uuid}",
                                        "label": "Yes"
                                    },
                                    {
                                        "concept": "${var.concept.ciel.no.uuid}",
                                        "label": "No"
                                    }
                                ]
                            }
                        },
                        {
                            "id": "followupDate",
                            "label": "Follow-up Date",
                            "type": "obs",
                            "questionOptions": {
                                "rendering": "date",
                                "concept": "${var.concept.ciel.followup-date.uuid}"
                            },
                            "hide": {
                                "hideWhenExpression": "isEmpty(followupRequired) || followupRequired !== '${var.concept.ciel.yes.uuid}'"
                            },
                            "validators": [
                                {
                                    "type": "date",
                                    "allowFutureDates": "true"
                                }
                            ]
                        },
                        {
                            "id": "outcomeDisposition",
                            "label": "Outcome/Disposition",
                            "type": "obs",
                            "questionOptions": {
