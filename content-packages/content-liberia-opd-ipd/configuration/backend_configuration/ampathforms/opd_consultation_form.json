                            "type": "obs",
                            "questionOptions": {
                                "rendering": "text",
                                "concept": "${var.concept.referral-destination.uuid}"
                            },
                            "hide": {
                                "hideWhenExpression": "isEmpty(outcomeDisposition) || outcomeDisposition !== '${var.concept.ciel.disposition-refer.uuid}'"
                            }
                        },
                        {
                            "id": "referralReason",
                            "label": "Reason for the referral.",
