{
  "_comment": [
    "OPD / IPD runtime configuration.",
    "Loaded after config-mch.json and before config-site.json. Must be listed in",
    "SPA_CONFIG_URLS or O3 will not read it (IMPLEMENTATION.md §7).",
    "Initial blood sugar is recorded from the card under Vitals and on the Vitals page.",
    "mg/dL is CIEL 887. mmol/L is CIEL 1458. The saved concept is the unit.",
    "The same card shows Triage, OPD, and Vitals values.",
    "Fasting blood glucose (CIEL 160912) is not this measurement."
  ],
  "liberia-rbs-history": {
    "title": "Initial blood sugar / RBS",
    "displayMode": "table",
    "showAddButton": true,
    "hideWhenEmpty": false,
    "formUuid": "",
    "entryWorkspace": "liberia-rbs-workspace",
    "entryEncounterType": "${var.encountertype.vitals.uuid}",
    "encounterTypes": [
      "${var.encountertype.triage.uuid}",
      "${var.encountertype.consultation.uuid}",
      "${var.encountertype.vitals.uuid}"
    ],
    "formUuids": [
      "${var.form.triage.uuid}",
      "${var.form.triage-form.v2-1.uuid}",
      "${var.form.opd-consultation.uuid}",
      "${var.form.opd-consultation-form.v2-1.uuid}"
    ],
    "dedicatedTypeUuids": [
      "${var.encountertype.triage.uuid}",
      "${var.encountertype.vitals.uuid}"
    ],
    "data": [
      {
        "label": "Initial blood sugar / RBS",
        "concept": "${var.concept.ciel.887.uuid}",
        "concepts": [
          {
            "concept": "${var.concept.ciel.887.uuid}",
            "unit": "mg/dL"
          },
          {
            "concept": "${var.concept.ciel.1458.uuid}",
            "unit": "mmol/L"
          }
        ]
      }
    ]
  }
}
