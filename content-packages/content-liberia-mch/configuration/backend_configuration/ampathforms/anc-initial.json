                "concept": "${var.concept.mch.pelvic-examination-abnormality-description.uuid}",
                "maxLength": "2000"
              },
              "id": "pelvicExaminationAbnormalityDescription",
              "label": "Describe abnormality",
              "required": true,
              "hide": {
                "hideWhenExpression": "pelvicExamination !== '${var.concept.ciel.abnormal.uuid}'"
              }
            }
          ]
        },
        {
          "label": "Maternal Assessment",
          "isExpanded": true,
          "questions": [
            {
              "type": "obs",
              "questionOptions": {
                "rendering": "number",
                "concept": "${var.concept.national.blood-pressure-systolic.uuid}",
                "min": "50",
                "max": "260"
              },
              "id": "systolicBloodPressure",
              "label": "Blood pressure (Systolic)",
              "required": true
            },
            {
              "type": "markdown",
              "id": "systolicBpWarning",
              "questionOptions": {
                "rendering": "markdown"
              },
              "hide": {
                "hideWhenExpression": "isEmpty(systolicBloodPressure) || systolicBloodPressure < 140"
              },
              "value": [
                "⚠️ **High Systolic BP (≥140 mmHg):** Evaluate for gestational hypertension / pre-eclampsia"
              ]
            },
            {
              "type": "obs",
              "questionOptions": {
                "rendering": "number",
                "concept": "${var.concept.national.blood-pressure-diastolic.uuid}",
                "min": "30",
                "max": "180"
              },
              "id": "diastolicBloodPressure",
              "label": "Blood pressure (Diastolic)",
              "required": true
            },
            {
              "type": "markdown",
              "id": "diastolicBpWarning",
              "questionOptions": {
                "rendering": "markdown"
              },
              "hide": {
                "hideWhenExpression": "isEmpty(diastolicBloodPressure) || diastolicBloodPressure < 90"
              },
              "value": [
                "⚠️ **High Diastolic BP (≥90 mmHg):** Evaluate for gestational hypertension / pre-eclampsia"
              ]
            },
            {
              "type": "obs",
              "questionOptions": {
                "rendering": "number",
                "concept": "${var.concept.ciel.weight-kg.uuid}",
                "min": "20",
                "max": "300"
              },
              "id": "weight",
              "label": "Weight",
              "required": true
            },
            {
              "type": "obs",
              "questionOptions": {
                "rendering": "number",
                "concept": "${var.concept.ciel.gestational-age.uuid}",
                "min": "0",
                "max": "45"
              },
              "id": "gestationalAge",
              "label": "Gestational age",
              "required": true
            },
            {
              "type": "obs",
              "questionOptions": {
                "rendering": "select",
                "concept": "${var.concept.ciel.pregnancy-status.uuid}",
                "answers": [
                  {
                    "concept": "${var.concept.national.1st-trimester.uuid}",
                    "label": "1st trimester"
                  },
                  {
                    "concept": "${var.concept.national.2nd-trimester.uuid}",
                    "label": "2nd trimester"
                  },
                  {
                    "concept": "${var.concept.national.3rd-trimester.uuid}",
                    "label": "3rd trimester"
                  }
                ],
                "isSearchable": false
              },
              "id": "pregnancyTrimester",
              "label": "Pregnancy trimester",
              "required": true
            }
          ]
        },
        {
          "label": "Fetal Assessment",
          "isExpanded": true,
          "questions": [
            {
              "type": "obs",
              "questionOptions": {
                "rendering": "number",
                "concept": "${var.concept.ciel.fundal-height.uuid}",
                "min": "0",
                "max": "50"
              },
              "id": "fundalHeight",
              "label": "Fundal height",
              "required": false
            },
            {
              "type": "obs",
              "questionOptions": {
                "rendering": "select",
                "concept": "${var.concept.mch.fetal-presentation.uuid}",
                "answers": [
                  {
                    "concept": "${var.concept.mch.presentation-breech.uuid}",
                    "label": "Breech"
                  },
                  {
                    "concept": "${var.concept.mch.presentation-oblique.uuid}",
                    "label": "Oblique"
                  },
                  {
                    "concept": "${var.concept.mch.presentation-transverse.uuid}",
                    "label": "Transverse"
                  },
                  {
                    "concept": "${var.concept.mch.presentation-vertex.uuid}",
                    "label": "Vertex"
                  },
                  {
                    "concept": "${var.concept.mch.presentation-other.uuid}",
                    "label": "Other"
                  }
                ]
              },
              "id": "fetalPresentation",
              "label": "Presentation",
              "required": false
            },
            {
              "type": "markdown",
              "id": "fetalPresentationWarning",
              "questionOptions": {
                "rendering": "markdown"
              },
              "hide": {
                "hideWhenExpression": "isEmpty(fetalPresentation) || fetalPresentation === '${var.concept.mch.presentation-vertex.uuid}'"
              },
              "value": [
                "⚠️ **Non-vertex Presentation:** Monitor and evaluate presentation for delivery planning"
              ]
            },
            {
              "type": "obs",
              "questionOptions": {
                "rendering": "number",
                "concept": "${var.concept.ciel.fetal-heart-rate.uuid}",
                "min": "60",
                "max": "220"
              },
              "id": "fetalHeartTone",
              "label": "Fetal heart tone (FHT)",
              "required": false
            },
            {
              "type": "markdown",
              "id": "fetalHeartToneWarning",
              "questionOptions": {
                "rendering": "markdown"
              },
              "hide": {
                "hideWhenExpression": "isEmpty(fetalHeartTone) || (fetalHeartTone >= 110 && fetalHeartTone <= 160)"
              },
              "value": [
                "⚠️ **Abnormal Fetal Heart Tone (<110 or >160 bpm):** Evaluate for fetal distress"
              ]
            },
            {
              "type": "obs",
              "questionOptions": {
                "rendering": "textarea",
                "concept": "${var.concept.national.other-findings.uuid}",
                "maxLength": "2000"
              },
              "id": "otherFindings",
              "label": "Other findings"
            }
          ]
        },
        {
          "label": "Preventive Interventions",
          "isExpanded": true,
          "questions": [
            {
              "type": "obs",
              "questionOptions": {
                "rendering": "radio",
                "concept": "${var.concept.national.woman-receiving-ipt.uuid}",
                "answers": [
                  {
                    "concept": "${var.concept.ciel.yes.uuid}",
                    "label": "Yes"
                  },
                  {
                    "concept": "${var.concept.ciel.no.uuid}",
                    "label": "No"
                  }
                ]
              },
              "id": "womanReceivingIpt",
              "label": "Woman receiving IPT",
              "required": true
            },
            {
              "type": "obs",
              "questionOptions": {
                "rendering": "select",
                "concept": "${var.concept.mch.ipt-dose-administered.uuid}",
                "answers": [
                  {
                    "concept": "${var.concept.mch.1st-ipt-dose.uuid}",
                    "label": "1st IPT dose"
                  },
                  {
                    "concept": "${var.concept.mch.2nd-ipt-dose.uuid}",
                    "label": "2nd IPT dose"
                  },
                  {
                    "concept": "${var.concept.mch.3rd-ipt-dose.uuid}",
                    "label": "3rd IPT dose"
                  },
                  {
                    "concept": "${var.concept.mch.4th-ipt-dose.uuid}",
                    "label": "4th IPT dose"
                  }
                ]
              },
              "id": "iptDoseAdministered",
              "label": "IPT dose administered",
              "required": false,
              "validators": [
                {
                  "type": "js_expression",
                  "failsWhenExpression": "womanReceivingIpt === '${var.concept.ciel.yes.uuid}' && isEmpty(myValue)",
                  "message": "Select the IPT dose administered"
                }
              ],
              "hide": {
                "hideWhenExpression": "womanReceivingIpt !== '${var.concept.ciel.yes.uuid}'"
              }
            },
            {
              "type": "obs",
              "questionOptions": {
                "rendering": "radio",
                "concept": "${var.concept.mch.iptp-deferral-reason.uuid}",
                "answers": [
                  {
                    "concept": "${var.concept.mch.iptp-deferred-malaria-treatment.uuid}",
                    "label": "Malaria treatment initiated"
                  }
                ]
              },
              "id": "iptpDeferralReason",
              "label": "IPTp deferral reason",
              "required": false,
              "hide": {
                "hideWhenExpression": "womanReceivingIpt !== '${var.concept.ciel.no.uuid}'"
              }
            },
            {
              "type": "obs",
              "questionOptions": {
                "rendering": "radio",
                "concept": "${var.concept.national.llin-received-at-anc.uuid}",
                "answers": [
                  {
                    "concept": "${var.concept.ciel.yes.uuid}",
                    "label": "Yes"
                  },
                  {
                    "concept": "${var.concept.ciel.no.uuid}",
                    "label": "No"
                  }
                ]
              },
              "id": "llinReceivedAtAnc",
              "label": "LLIN received at ANC"
            }
          ]
        },
        {
          "label": "Management Notes",
          "isExpanded": true,
          "questions": [
            {
