                "maxLength": "2000"
              },
              "id": "breastsAbnormalityDescription",
              "label": "Describe abnormality",
              "required": true,
              "hide": {
                "hideWhenExpression": "breasts !== '${var.concept.ciel.abnormal.uuid}'"
              }
            },
            {
              "type": "obs",
              "questionOptions": {
                "rendering": "radio",
                "concept": "${var.concept.national.nipples.uuid}",
                "answers": [
                  {
                    "concept": "${var.concept.ciel.abnormal.uuid}",
                    "label": "Abnormal"
                  },
                  {
                    "concept": "${var.concept.ciel.normal.uuid}",
                    "label": "Normal"
                  }
                ]
              },
              "id": "nipples",
              "label": "Nipples",
              "required": false
            },
            {
              "type": "obs",
              "questionOptions": {
                "rendering": "textarea",
                "concept": "${var.concept.mch.nipples-abnormality-description.uuid}",
                "maxLength": "2000"
              },
              "id": "nipplesAbnormalityDescription",
              "label": "Describe abnormality",
              "required": true,
              "hide": {
                "hideWhenExpression": "nipples !== '${var.concept.ciel.abnormal.uuid}'"
              }
            },
            {
              "type": "obs",
              "questionOptions": {
                "rendering": "radio",
                "concept": "${var.concept.national.abdomen.uuid}",
                "answers": [
                  {
                    "concept": "${var.concept.ciel.abnormal.uuid}",
                    "label": "Abnormal"
                  },
                  {
                    "concept": "${var.concept.ciel.normal.uuid}",
                    "label": "Normal"
                  }
                ]
              },
              "id": "abdomen",
              "label": "Abdomen",
