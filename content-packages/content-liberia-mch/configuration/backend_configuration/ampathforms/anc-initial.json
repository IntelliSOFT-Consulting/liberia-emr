{
  "name": "ANC Initial Visit",
  "pages": [
    {
      "label": "Initial ANC Assessment",
      "sections": [
        {
          "label": "Obstetric History",
          "isExpanded": true,
          "questions": [
            {
              "type": "obs",
              "questionOptions": {
                "rendering": "number",
                "concept": "${var.concept.ciel.gravida.uuid}",
                "min": 1,
                "step": 1,
                "disallowDecimals": true
              },
              "id": "gravida",
              "label": "Gravida",
              "required": true,
              "validators": [
                {
                  "type": "js_expression",
                  "failsWhenExpression": "!isEmpty(myValue) && !isEmpty(fullTermBirths) && !isEmpty(pretermBirths) && !isEmpty(abortions) && myValue !== fullTermBirths + pretermBirths + abortions + 1",
                  "message": "The obstetric history is inconsistent. Gravida includes the current pregnancy and must correspond to the number of previous pregnancy outcomes. Please review Gravida, Full-term births, Preterm births and Abortions."
                }
              ]
            },
            {
              "type": "obs",
              "questionOptions": {
                "rendering": "date",
                "concept": "${var.concept.ciel.lmp.uuid}"
              },
              "id": "lmp",
              "label": "Last Menstrual Period (LMP)",
              "required": true,
              "datePickerFormat": "calendar",
              "validators": [
                {
                  "type": "date",
                  "allowFutureDates": false
                },
                {
                  "type": "js_expression",
                  "failsWhenExpression": "!isEmpty(myValue) && calcAgeBasedOnDate(myValue) < 0",
                  "message": "Date cannot be before the patient's date of birth."
                }
              ]
            },
            {
              "type": "obs",
              "questionOptions": {
                "rendering": "number",
                "concept": "${var.concept.ciel.full-term-births.uuid}",
                "min": 0,
                "step": 1,
                "disallowDecimals": true
              },
              "id": "fullTermBirths",
              "label": "Full-term births (FT)",
              "required": true,
              "validators": [
                {
                  "type": "js_expression",
                  "failsWhenExpression": "!isEmpty(gravida) && !isEmpty(myValue) && !isEmpty(pretermBirths) && !isEmpty(abortions) && gravida !== myValue + pretermBirths + abortions + 1",
                  "message": "The obstetric history is inconsistent. Gravida includes the current pregnancy and must correspond to the number of previous pregnancy outcomes. Please review Gravida, Full-term births, Preterm births and Abortions."
                }
              ]
            },
            {
              "type": "obs",
              "questionOptions": {
                "rendering": "number",
                "concept": "${var.concept.ciel.preterm-births.uuid}",
                "min": 0,
                "step": 1,
                "disallowDecimals": true
              },
              "id": "pretermBirths",
              "label": "Preterm births (P)",
              "required": true,
              "validators": [
                {
                  "type": "js_expression",
                  "failsWhenExpression": "!isEmpty(gravida) && !isEmpty(fullTermBirths) && !isEmpty(myValue) && !isEmpty(abortions) && gravida !== fullTermBirths + myValue + abortions + 1",
                  "message": "The obstetric history is inconsistent. Gravida includes the current pregnancy and must correspond to the number of previous pregnancy outcomes. Please review Gravida, Full-term births, Preterm births and Abortions."
                }
              ]
            },
            {
              "type": "obs",
              "questionOptions": {
                "rendering": "number",
                "concept": "${var.concept.ciel.abortions.uuid}",
                "min": 0,
                "step": 1,
                "disallowDecimals": true
              },
              "id": "abortions",
              "label": "Abortions (A)",
              "required": true,
              "validators": [
                {
                  "type": "js_expression",
                  "failsWhenExpression": "!isEmpty(gravida) && !isEmpty(fullTermBirths) && !isEmpty(pretermBirths) && !isEmpty(myValue) && gravida !== fullTermBirths + pretermBirths + myValue + 1",
                  "message": "The obstetric history is inconsistent. Gravida includes the current pregnancy and must correspond to the number of previous pregnancy outcomes. Please review Gravida, Full-term births, Preterm births and Abortions."
                }
              ]
            },
            {
              "type": "obs",
              "questionOptions": {
                "rendering": "number",
                "concept": "${var.concept.ciel.living-children.uuid}",
                "min": 0,
                "step": 1,
                "disallowDecimals": true
              },
              "id": "livingChildren",
              "label": "Living children (LN)",
              "required": true,
              "validators": [
                {
                  "type": "js_expression",
                  "failsWhenExpression": "!isEmpty(myValue) && !isEmpty(fullTermBirths) && !isEmpty(pretermBirths) && myValue > 0 && fullTermBirths + pretermBirths === 0",
                  "message": "Living children cannot be recorded without a previous pregnancy resulting in a birth. Please review the obstetric history."
                }
              ]
            }
          ]
        },
        {
          "label": "Physical Examination",
          "isExpanded": true,
          "questions": [
            {
              "type": "obs",
              "questionOptions": {
                "rendering": "radio",
                "concept": "${var.concept.national.color.uuid}",
                "answers": [
                  {
                    "concept": "${var.concept.ciel.abnormal.uuid}",
                    "label": "Abnormal"
                  },
                  {
                    "concept": "${var.concept.ciel.normal.uuid}",
                    "label": "Normal"
                  }
                ]
              },
              "id": "physicalExamColour",
              "label": "Colour",
              "required": false
            },
            {
              "type": "obs",
              "questionOptions": {
                "rendering": "textarea",
                "concept": "${var.concept.mch.colour-abnormality-description.uuid}",
                "maxLength": "2000"
              },
              "id": "colourAbnormalityDescription",
              "label": "Describe abnormality",
              "required": true,
              "hide": {
                "hideWhenExpression": "physicalExamColour !== '${var.concept.ciel.abnormal.uuid}'"
