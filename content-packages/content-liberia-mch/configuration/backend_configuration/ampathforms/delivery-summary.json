            },
            {
              "label": "Diastolic BP",
              "id": "dbp",
              "type": "obs",
              "questionOptions": {
                "rendering": "number",
                "concept": "${var.concept.ciel.diastolic-bp.uuid}"
              }
            },
            {
              "label": "Pulse",
              "id": "pulse",
              "type": "obs",
              "questionOptions": {
                "rendering": "number",
                "concept": "${var.concept.ciel.pulse.uuid}"
              }
            },
            {
              "label": "Temperature (°C)",
              "id": "temp",
              "type": "obs",
              "questionOptions": {
                "rendering": "number",
                "concept": "${var.concept.ciel.temperature.uuid}"
              }
            },
            {
              "label": "Gestational Age (weeks)",
              "id": "ga",
              "type": "obs",
              "questionOptions": {
                "rendering": "number",
                "concept": "${var.concept.ciel.gestational-age.uuid}"
              }
            },
            {
              "label": "Cervical Dilation (cm)",
              "id": "cervical_dilation",
              "type": "obs",
              "questionOptions": {
                "rendering": "number",
                "concept": "${var.concept.partograph.cervical-dilation.uuid}",
