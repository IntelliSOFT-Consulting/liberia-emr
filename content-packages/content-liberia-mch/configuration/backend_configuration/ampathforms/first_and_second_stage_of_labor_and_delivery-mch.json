{
  "name": "1. First and Second Stage of Labor and Delivery",
  "uuid": "${var.form.first-and-second-stage-of-labor-and-delivery.uuid}",
  "version": "1.1",
  "published": true,
  "retired": false,
  "processor": "EncounterFormProcessor",
  "encounter": "Labor & Delivery",
  "referencedForms": [],
  "pages": [
    {
      "label": "First and Second Stage of Labor and Delivery",
      "sections": [
        {
          "label": "First and Second Stage of Labor and Delivery",
          "isExpanded": true,
          "questions": [
            {
              "type": "markdown",
              "id": "partograph_recording_alert",
              "questionOptions": {
                "rendering": "markdown"
              },
              "value": [
                "**Partograph Recording**",
                "",
                "Upon completion of the First Stage of Delivery form, you will proceed to the partograph to commence recording and monitoring the patient's labour progress."
              ]
            },
            {
              "label": "Oxygen saturation (SpO2)",
              "type": "obs",
              "id": "spo2",
              "questionOptions": {
                "concept": "${var.concept.national.oxygen-saturation-spo2.uuid}",
                "rendering": "number",
                "min": 0,
                "max": 100,
                "step": 1
              },
              "validators": [
                {
                  "type": "js_expression",
                  "failsWhenExpression": "!isEmpty(myValue) && (myValue < 0 || myValue > 100)",
                  "message": "Value must be between 0 and 100"
                }
              ]
            }
          ]
        },
        {
          "label": "Blood Pressure",
          "isExpanded": true,
          "questions": [
            {
              "label": "Systolic",
              "type": "obs",
              "id": "bp_sys",
              "questionOptions": {
                "concept": "${var.concept.ciel.systolic-bp.uuid}",
                "rendering": "number",
                "min": 0,
                "max": 250,
                "step": 1
              },
              "validators": [
                {
                  "type": "js_expression",
                  "failsWhenExpression": "!isEmpty(myValue) && (myValue < 0 || myValue > 250)",
                  "message": "Value must be between 0 and 250"
                }
              ]
            },
            {
              "label": "Diastolic",
              "type": "obs",
              "id": "bp_dia",
              "questionOptions": {
                "concept": "${var.concept.ciel.diastolic-bp.uuid}",
                "rendering": "number",
                "min": 0,
                "max": 200,
                "step": 1
              },
              "validators": [
                {
                  "type": "js_expression",
                  "failsWhenExpression": "!isEmpty(myValue) && (myValue < 0 || myValue > 200)",
                  "message": "Value must be between 0 and 200"
                }
              ]
            }
          ]
        },
        {
          "label": "Clinical Observations",
          "isExpanded": true,
          "questions": [
            {
              "label": "Fetal heart rate",
              "type": "obs",
              "id": "fhr",
              "questionOptions": {
                "concept": "${var.concept.ciel.fetal-heart-rate.uuid}",
                "rendering": "number",
                "min": 40,
                "max": 250,
                "step": 1
              },
              "validators": [
                {
                  "type": "js_expression",
                  "failsWhenExpression": "!isEmpty(myValue) && (myValue < 40 || myValue > 250)",
                  "message": "Value must be between 40 and 250"
                }
              ]
            },
            {
              "label": "Gravida",
              "type": "obs",
              "id": "gravida",
              "questionOptions": {
                "concept": "${var.concept.ciel.gravida.uuid}",
                "rendering": "number",
                "min": 1,
                "step": 1,
                "disallowDecimals": true,
                "calculate": {
                  "calculateExpression": "mode === 'enter' && isEmpty(myValue) ? getCurrentPregnancyAncNumeric(patient.id, '${var.concept.ciel.gravida.uuid}').then(v => v) : myValue"
                }
              }
            },
            {
              "label": "Parity",
              "type": "obs",
              "id": "parity",
              "questionOptions": {
                "concept": "${var.concept.ciel.parity.uuid}",
                "rendering": "number",
                "min": 0,
                "step": 1,
                "disallowDecimals": true,
                "calculate": {
                  "calculateExpression": "mode === 'enter' && isEmpty(myValue) ? getCurrentPregnancyAncNumeric(patient.id, '${var.concept.ciel.parity.uuid}').then(v => v) : myValue"
                }
              },
              "validators": [
                {
                  "type": "js_expression",
                  "failsWhenExpression": "!isEmpty(myValue) && !isEmpty(gravida) && myValue > gravida",
                  "message": "Parity cannot be greater than Gravida."
                }
              ]
            },
            {
              "label": "Adequate tetanus-diphtheria (TD2+) immunization",
              "type": "obs",
              "id": "td2",
              "questionOptions": {
                "concept": "${var.concept.national.adequate-tetanus-diphtheria-td2-immunization.uuid}",
                "rendering": "radio",
                "answers": [
                  {
                    "concept": "${var.concept.ciel.yes.uuid}",
                    "label": "Yes"
                  },
                  {
                    "concept": "${var.concept.ciel.no.uuid}",
                    "label": "No"
                  }
                ]
              }
            },
