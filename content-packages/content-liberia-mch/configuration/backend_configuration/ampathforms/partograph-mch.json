{
  "name": "2. Partograph",
  "uuid": "${var.form.partograph.uuid}",
  "version": "1.0",
  "published": true,
  "retired": false,
  "processor": "EncounterFormProcessor",
  "encounter": "Labor & Delivery",
  "referencedForms": [],
  "pages": [
    {
      "label": "Partograph",
      "sections": [
        {
          "label": "Ongoing Partograph Monitoring",
          "isExpanded": true,
          "questions": [
            {
              "type": "markdown",
              "id": "partograph_ongoing_alert",
              "questionOptions": {
                "rendering": "markdown"
              },
              "value": [
                "**Ongoing Partograph Monitoring**",
                "",
                "This form is completed periodically throughout labour. You will receive reminders when recordings are due and alerts when clinical attention may be required. The patient's labour progress can be monitored in the Partograph section."
              ]
            },
            {
              "label": "Fetal heart rate",
              "type": "obs",
              "id": "fetal_heart_rate",
              "questionOptions": {
                "concept": "${var.concept.ciel.fetal-heart-rate.uuid}",
                "rendering": "number",
                "min": 40,
                "max": 250,
                "step": 1
              },
              "validators": [
                {
                  "type": "js_expression",
                  "failsWhenExpression": "!isEmpty(myValue) && (myValue < 40 || myValue > 250)",
                  "message": "Value must be between 40 and 250"
                }
              ]
            },
            {
              "label": "Amniotic fluid",
              "type": "obs",
              "id": "amniotic_fluid",
              "questionOptions": {
                "concept": "${var.concept.partograph.amniotic-fluid.uuid}",
                "rendering": "select",
                "answers": [
                  {
                    "concept": "${var.concept.partograph.clear-liquor.uuid}",
                    "label": "Clear"
                  },
                  {
                    "concept": "${var.concept.partograph.membranes-intact.uuid}",
                    "label": "Intact"
                  },
                  {
                    "concept": "${var.concept.partograph.meconium-liquor.uuid}",
                    "label": "Meconium-stained"
                  },
                  {
                    "concept": "${var.concept.partograph.blood-liquor.uuid}",
                    "label": "Blood-stained"
                  },
                  {
                    "concept": "${var.concept.partograph.absent-liquor.uuid}",
                    "label": "Absent"
                  }
                ]
              }
            },
            {
              "label": "Moulding",
              "type": "obs",
              "id": "moulding",
              "questionOptions": {
                "concept": "${var.concept.mch.moulding.uuid}",
                "rendering": "select",
                "answers": [
                  {
                    "concept": "${var.concept.mch.moulding-0.uuid}",
                    "label": "0 — None"
                  },
                  {
                    "concept": "${var.concept.mch.moulding-plus-1.uuid}",
                    "label": "+ — Mild"
                  },
                  {
                    "concept": "${var.concept.mch.moulding-plus-2.uuid}",
                    "label": "++ — Moderate"
                  },
                  {
                    "concept": "${var.concept.mch.moulding-plus-3.uuid}",
                    "label": "+++ — Severe"
                  }
                ]
              }
            },
            {
              "label": "Cervical dilatation",
