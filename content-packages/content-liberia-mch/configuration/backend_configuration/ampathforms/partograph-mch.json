              "id": "cervical_dilatation",
              "questionOptions": {
                "concept": "${var.concept.mch.cervical-dilatation.uuid}",
                "rendering": "number",
                "min": 0,
                "max": 10,
                "step": 1
              },
              "validators": [
                {
                  "type": "js_expression",
                  "failsWhenExpression": "!isEmpty(myValue) && (myValue < 0 || myValue > 10)",
                  "message": "Value must be between 0 and 10"
                }
