              "validators": [
                {
                  "type": "js_expression",
                  "failsWhenExpression": "!isEmpty(myValue) && (myValue % 1 !== 0 || myValue < 0)",
                  "message": "Only positive whole numbers (no decimal values) are allowed"
                }
              ]
            },
