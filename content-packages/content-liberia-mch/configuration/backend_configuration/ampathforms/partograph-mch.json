{
  "name": "2. Partograph",
  "uuid": "${var.form.partograph.uuid}",
  "version": "1.0",
  "published": true,
  "retired": false,
  "processor": "EncounterFormProcessor",
  "encounter": "Labor & Delivery",
  "referencedForms": [],
  "pages": [
    {
      "label": "Partograph",
      "sections": [
        {
          "label": "Ongoing Partograph Monitoring",
          "isExpanded": true,
          "questions": [
            {
              "type": "markdown",
              "id": "partograph_ongoing_alert",
              "questionOptions": {
                "rendering": "markdown"
              },
              "value": [
                "**Ongoing Partograph Monitoring**",
                "",
                "This form is completed periodically throughout labour. You will receive reminders when recordings are due and alerts when clinical attention may be required. The patient's labour progress can be monitored in the Partograph section."
              ]
            },
            {
              "label": "Fetal heart rate (beats/min)",
              "type": "obs",
              "id": "fetal_heart_rate",
              "questionOptions": {
                "concept": "${var.concept.ciel.fetal-heart-rate.uuid}",
                "rendering": "number",
                "min": 40,
                "max": 250,
                "step": 1,
                "disallowDecimals": true
              },
              "validators": [
                {
                  "type": "js_expression",
                  "failsWhenExpression": "!isEmpty(myValue) && (myValue < 40 || myValue > 250)",
                  "message": "Fetal heart rate must be between 40 and 250 beats/min."
                },
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "!isEmpty(myValue) && (myValue < 120 || myValue > 160)",
                  "message": "Fetal heart rate is outside the normal range (120–160 beats/min). Please verify the reading."
                }
              ]
            },
            {
              "label": "Amniotic fluid",
              "type": "obs",
              "id": "amniotic_fluid",
              "questionOptions": {
                "concept": "${var.concept.partograph.amniotic-fluid.uuid}",
                "rendering": "select",
                "answers": [
                  {
                    "concept": "${var.concept.partograph.clear-liquor.uuid}",
                    "label": "Clear"
                  },
                  {
                    "concept": "${var.concept.partograph.membranes-intact.uuid}",
                    "label": "Intact"
                  },
                  {
                    "concept": "${var.concept.partograph.meconium-liquor.uuid}",
                    "label": "Meconium-stained"
                  },
                  {
                    "concept": "${var.concept.partograph.blood-liquor.uuid}",
                    "label": "Blood-stained"
                  },
                  {
                    "concept": "${var.concept.partograph.absent-liquor.uuid}",
                    "label": "Absent"
                  }
                ]
              }
            },
            {
              "label": "Moulding",
              "type": "obs",
              "id": "moulding",
              "questionOptions": {
                "concept": "${var.concept.mch.moulding.uuid}",
                "rendering": "select",
                "answers": [
                  {
                    "concept": "${var.concept.mch.moulding-0.uuid}",
                    "label": "0 — None"
                  },
                  {
                    "concept": "${var.concept.mch.moulding-plus-1.uuid}",
                    "label": "+ — Mild"
                  },
                  {
                    "concept": "${var.concept.mch.moulding-plus-2.uuid}",
                    "label": "++ — Moderate"
                  },
                  {
                    "concept": "${var.concept.mch.moulding-plus-3.uuid}",
                    "label": "+++ — Severe"
                  }
                ]
              }
            },
            {
              "label": "Cervical dilatation",
              "type": "obs",
              "id": "cervical_dilatation",
              "questionOptions": {
                "concept": "${var.concept.partograph.cervical-dilation.uuid}",
                "rendering": "number",
                "min": 0,
                "max": 10,
                "step": 1
              },
              "validators": [
                {
                  "type": "js_expression",
                  "failsWhenExpression": "!isEmpty(myValue) && (myValue < 0 || myValue > 10)",
                  "message": "Value must be between 0 and 10"
                }
              ]
            },
            {
              "label": "Fetal head descent",
              "type": "obs",
              "id": "fetal_head_descent",
              "questionOptions": {
                "concept": "${var.concept.partograph.descent-of-head.uuid}",
                "rendering": "number",
                "min": 0,
                "max": 5,
                "step": 1
              },
              "validators": [
                {
                  "type": "js_expression",
                  "failsWhenExpression": "!isEmpty(myValue) && (myValue < 0 || myValue > 5)",
                  "message": "Value must be between 0 and 5"
                }
              ]
            },
            {
              "label": "Contractions per 10 minutes",
              "type": "obs",
              "id": "contractions_per_10_minutes",
              "questionOptions": {
                "concept": "${var.concept.partograph.contractions-per-10min.uuid}",
                "rendering": "number",
                "min": 0,
                "max": 10,
                "step": 1
              },
              "validators": [
                {
                  "type": "js_expression",
                  "failsWhenExpression": "!isEmpty(myValue) && (myValue < 0 || myValue > 10)",
                  "message": "Value must be between 0 and 10"
                }
              ]
            },
            {
              "label": "Units of oxytocin/litre given per minute",
              "type": "obs",
              "id": "units_of_oxytocin_litre_given_per_minute",
              "questionOptions": {
                "concept": "${var.concept.mch.units-of-oxytocin-litre-given-per-minute.uuid}",
                "rendering": "number",
                "min": 0,
                "step": 1
              },
              "validators": [
                {
                  "type": "js_expression",
                  "failsWhenExpression": "!isEmpty(myValue) && (myValue % 1 !== 0 || myValue < 0)",
                  "message": "Only positive whole numbers (no decimal values) are allowed"
                }
              ]
            },
            {
              "label": "Drugs given and IV Fluids",
              "type": "obs",
              "id": "drugs_given_and_iv_fluids",
              "questionOptions": {
                "concept": "${var.concept.mch.drugs-given-and-iv-fluids.uuid}",
                "rendering": "text"
              }
            },
            {
              "label": "Pulse Rate (bpm)",
              "type": "obs",
              "id": "pulse_rate",
              "questionOptions": {
                "concept": "${var.concept.ciel.pulse.uuid}",
                "rendering": "number",
                "min": 0,
                "max": 300,
                "step": 1,
                "disallowDecimals": true
              },
              "validators": [
                {
                  "type": "js_expression",
                  "failsWhenExpression": "!isEmpty(myValue) && (myValue < 0 || myValue > 300)",
                  "message": "Pulse Rate must be between 0 and 300 bpm."
                },
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "!isEmpty(myValue) && (myValue < 60 || myValue > 100)",
                  "message": "Pulse Rate is outside the normal range (60–100 bpm). Please verify the reading."
                }
              ]
            }
          ]
        },
        {
          "label": "Blood Pressure",
          "isExpanded": true,
          "questions": [
            {
              "label": "Systolic (mmHg)",
              "type": "obs",
              "id": "bp_sys",
              "questionOptions": {
                "concept": "${var.concept.ciel.systolic-bp.uuid}",
                "rendering": "number",
                "min": 0,
                "max": 250,
                "step": 1,
                "disallowDecimals": true
              },
              "validators": [
                {
                  "type": "js_expression",
                  "failsWhenExpression": "!isEmpty(myValue) && (myValue < 0 || myValue > 250)",
                  "message": "Systolic Blood Pressure must be between 0 and 250 mmHg."
                },
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "!isEmpty(myValue) && (myValue < 100 || myValue > 140)",
                  "message": "Systolic BP is outside the normal range (100–140 mmHg). Please verify the reading."
                }
              ]
            },
            {
              "label": "Diastolic (mmHg)",
              "type": "obs",
              "id": "bp_dia",
              "questionOptions": {
                "concept": "${var.concept.ciel.diastolic-bp.uuid}",
                "rendering": "number",
                "min": 0,
                "max": 150,
                "step": 1,
                "disallowDecimals": true
              },
              "validators": [
                {
                  "type": "js_expression",
                  "failsWhenExpression": "!isEmpty(myValue) && (myValue < 0 || myValue > 150)",
                  "message": "Diastolic Blood Pressure must be between 0 and 150 mmHg."
                },
                {
                  "type": "js_expression",
                  "failsWhenExpression": "!isEmpty(bp_sys) && !isEmpty(myValue) && myValue >= bp_sys",
                  "message": "Diastolic pressure cannot be greater than or equal to systolic pressure."
                },
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "!isEmpty(myValue) && (myValue < 55 || myValue > 90)",
                  "message": "Diastolic BP is outside the normal range (55–90 mmHg). Please verify the reading."
                }
              ]
            }
          ]
        },
        {
          "label": "Urinalysis and Temperature",
          "isExpanded": true,
          "questions": [
            {
              "label": "Temperature (°C)",
              "type": "obs",
              "id": "temperature",
              "questionOptions": {
                "concept": "${var.concept.ciel.temperature.uuid}",
                "rendering": "number",
                "min": 20,
                "max": 45,
                "step": 0.1
              },
              "validators": [
                {
                  "type": "js_expression",
                  "failsWhenExpression": "!isEmpty(myValue) && (myValue < 20 || myValue > 45)",
                  "message": "Temperature must be between 20 and 45 °C."
                },
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "!isEmpty(myValue) && (myValue < 36 || myValue > 38)",
                  "message": "Temperature is outside the normal range (36–38 °C). Please verify the reading."
                }
              ]
            },
            {
              "label": "Proteins in urine",
              "type": "obs",
              "id": "proteins_in_urine",
              "questionOptions": {
                "concept": "${var.concept.mch.proteins-in-urine.uuid}",
                "rendering": "select",
                "answers": [
                  {
                    "concept": "${var.concept.mch.negative.uuid}",
                    "label": "Negative"
                  },
                  {
                    "concept": "${var.concept.mch.plus-1.uuid}",
                    "label": "+"
                  },
                  {
                    "concept": "${var.concept.mch.plus-2.uuid}",
                    "label": "++"
                  },
                  {
                    "concept": "${var.concept.mch.plus-3.uuid}",
                    "label": "+++"
                  },
                  {
                    "concept": "${var.concept.mch.plus-4.uuid}",
                    "label": "++++"
                  }
                ]
              }
            },
            {
              "label": "Acetone in urine",
              "type": "obs",
              "id": "acetone_in_urine",
              "questionOptions": {
                "concept": "${var.concept.mch.acetone-in-urine.uuid}",
                "rendering": "select",
                "answers": [
                  {
                    "concept": "${var.concept.mch.negative.uuid}",
                    "label": "Negative"
                  },
                  {
                    "concept": "${var.concept.mch.plus-1.uuid}",
                    "label": "+"
                  },
                  {
                    "concept": "${var.concept.mch.plus-2.uuid}",
                    "label": "++"
                  },
                  {
                    "concept": "${var.concept.mch.plus-3.uuid}",
                    "label": "+++"
                  },
                  {
                    "concept": "${var.concept.mch.plus-4.uuid}",
                    "label": "++++"
                  }
                ]
              }
            },
            {
              "label": "Urine Volume",
              "type": "obs",
              "id": "urine_volume",
              "questionOptions": {
                "concept": "${var.concept.mch.urine-volume.uuid}",
                "rendering": "number",
                "min": 0,
                "max": 5000,
                "step": 1
              },
              "validators": [
                {
                  "type": "js_expression",
                  "failsWhenExpression": "!isEmpty(myValue) && (myValue < 0 || myValue > 5000)",
                  "message": "Value must be between 0 and 5000"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
