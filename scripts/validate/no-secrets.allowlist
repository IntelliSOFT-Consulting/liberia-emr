# Known throwaway credentials that no-secrets.sh may see in config files (LE-340).
#
# One entry per line: KEY=VALUE, both matched exactly (the key case-sensitively), in any
# config file. Everything after " #" is the reason, and every entry must have one. Add an
# entry only for a value that protects nothing: a disposable CI database, a public demo login,
# a well-known default. A real credential never belongs here. Take it out of the repository,
# rotate it, and load it from the environment instead.

# CI end-to-end stack (.github/workflows/ci.yml): databases that live only as long as the job.
MYSQL_PASSWORD=ci-ephemeral  # disposable CI database, destroyed with the job
MYSQL_ROOT_PASSWORD=ci-ephemeral-root  # disposable CI database, destroyed with the job
ETL_DB_PASSWORD=ci-ephemeral-etl  # disposable CI reporting-ETL user (LE-367)

# Sync broker hardening job (ci.yml): one-letter values fed to containers that must refuse
# to start for another reason. The value is never used to authenticate.
OPENMRS_DB_PASSWORD=p  # refusal test input, never authenticates
OPENMRS_REST_PASSWORD=p  # refusal test input, never authenticates
MGMT_DB_PASSWORD=p  # refusal test input, never authenticates
DEBEZIUM_DB_PASSWORD=p  # refusal test input, never authenticates

# The demo stack's published login and its template (distribution/env/demo.env.example).
CYPRESS_PASSWORD=Admin123  # the public O3 demo admin login; the demo stack is never production
MYSQL_PASSWORD=demo-not-a-secret  # demo template value, named as not a secret
MYSQL_ROOT_PASSWORD=demo-not-a-secret-root  # demo template value, named as not a secret
ETL_DB_PASSWORD=demo-not-a-secret-etl  # demo template value, named as not a secret

# QA MFL stub (qa/api/mfl-stub): the JDK's documented default truststore password, protecting
# a truststore of public CA certificates plus the stub's throwaway CA.
-Djavax.net.ssl.trustStorePassword=changeit  # JDK default truststore password, guards only public certs

# modules.yml hands actions/setup-java the NAME of the environment variable that carries the
# Repsy password into Maven, not the password itself.
server-password=REPSY_PW  # an environment variable name, not a value
