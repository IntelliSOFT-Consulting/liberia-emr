# Copy to backup.env, fill in real values, then run: ./render.sh backup.env
# backup.env is git-ignored. Never commit it.
#
# Allowed in values: letters, digits, spaces, and _ @ . / : , + = - *
# Not allowed: quotes, $, backtick, backslash, ; & | < > ( ) %

# Containers (docker ps --format '{{.Names}}')
CONTAINER_NAME=myproject-db-1
BACKEND_CONTAINER=myproject-backend-1
# Optional: any other containers that write to the database directly and must
# also be stopped during a real restore (comma-separated). Leave this line out
# entirely if there are none.
#EXTRA_STOP_CONTAINERS=myproject-sync-1, myproject-sync-capture-1

# Database
DB_NAME=mydatabase
DB_USER=myuser

# Compose env file that holds MYSQL_PASSWORD (read at run time, never copied here)
ENV_FILE=/path/to/compose/project.env

# Backup storage
BACKUP_DIR=/path/to/backups
RETENTION_DAYS=14
LOG_FILE=/var/log/myproject-backup.log

# Encryption (backups contain patient data, keep this true)
ENCRYPT_BACKUPS=true
GPG_RECIPIENT=REPLACE_ME

# Optional remote upload (requires ENCRYPT_BACKUPS=true). All four of these
# are optional — leave the whole block commented out for local-only backups,
# or set only the ones you need. Defaults if omitted:
#   REMOTE_UPLOAD=false, UPLOAD_METHOD=rclone, RCLONE_REMOTE="", SCP_DESTINATION=""
#
# UPLOAD_METHOD picks how: "rclone" (S3, Google Drive, SFTP, etc — configure
# with `rclone config` first) or "scp" (one server, plain SSH key access).
# You only need to set the ONE destination that matches your UPLOAD_METHOD —
# no need to fill in both.
#REMOTE_UPLOAD=true
#UPLOAD_METHOD=rclone
#RCLONE_REMOTE=myremote:mybucket
#SCP_DESTINATION=backups@example.com:/srv/backups/

# Cron installer: where the rendered backup script will live, and when it runs
BACKUP_SCRIPT_PATH=/path/to/scripts/backup-liberiaemr-db.sh
CRON_SCHEDULE=0 */8 * * *
CRON_LOG_FILE=/var/log/myproject-backup-cron.log