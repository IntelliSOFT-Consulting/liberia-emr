<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.openmrs.module</groupId>
		<artifactId>liberiaemr</artifactId>
		<version>1.0.1-SNAPSHOT</version>
	</parent>

	<artifactId>liberiaemr-api</artifactId>
	<packaging>jar</packaging>
	<name>LiberiaEMR API</name>
	<description>API project for LiberiaEMR</description>

	<dependencies>
		<dependency>
			<groupId>javax.mail</groupId>
			<artifactId>mail</artifactId>
			<version>1.4.7</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-context-support</artifactId>
			<version>5.3.31</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.openmrs</groupId>
			<artifactId>event-api</artifactId>
			<version>4.0.0</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.bahmni.module</groupId>
			<artifactId>appointments-api</artifactId>
			<version>2.1.0</version>
			<scope>provided</scope>
		</dependency>
	</dependencies>
	<build>
		<!--
			Everything except the UUID file is copied verbatim. The UUID file is resolved from the
			content layers' variables.properties (ADR 0010 decision 7), the same way
			modules/liberiaemrreports and content-packages/pom.xml resolve ${var.*}: delimiter ${*} only.
		-->
		<resources>
			<resource>
				<directory>src/main/resources</directory>
				<filtering>false</filtering>
				<excludes>
					<exclude>liberiaemr-uuids.properties</exclude>
				</excludes>
			</resource>
			<resource>
				<directory>src/main/resources</directory>
				<filtering>true</filtering>
				<includes>
					<include>liberiaemr-uuids.properties</include>
				</includes>
			</resource>
		</resources>
		<filters>
			<filter>${liberiaemr.content.dir}/content-common/configuration/variables.properties</filter>
			<filter>${liberiaemr.content.dir}/content-liberia-national/configuration/variables.properties</filter>
			<filter>${liberiaemr.content.dir}/content-liberia-mch/configuration/variables.properties</filter>
			<filter>${liberiaemr.content.dir}/content-liberia-opd-ipd/configuration/variables.properties</filter>
		</filters>
		<!--
			The MFL tests read the real fixture from integration/dhis2/mfl/fixtures (LE-318) rather
			than a copy that could drift from it. A build that has only this module (the backend
			image's module stage) skips tests, and a missing test resource directory is skipped
			too, so that build is unaffected.
		-->
		<testResources>
			<!-- Exercise actual configured grants, including role inheritance, rather than a copied model. -->
			<testResource>
				<directory>${liberiaemr.content.dir}/content-common/configuration/backend_configuration</directory>
				<includes>
					<include>roles/roles-common.csv</include>
					<include>privileges/privileges-module-access-common.csv</include>
				</includes>
				<targetPath>module-access-content</targetPath>
			</testResource>
			<testResource>
				<directory>src/test/resources</directory>
			</testResource>
			<testResource>
				<directory>${project.basedir}/../../../integration/dhis2/mfl/fixtures</directory>
				<targetPath>mfl-fixtures</targetPath>
			</testResource>
		</testResources>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
				<configuration>
					<encoding>UTF-8</encoding>
					<propertiesEncoding>UTF-8</propertiesEncoding>
					<useDefaultDelimiters>false</useDefaultDelimiters>
					<delimiters>
						<delimiter>${*}</delimiter>
					</delimiters>
				</configuration>
			</plugin>
			<!--
				ADR 0010 decision 7, check 3: the build fails if a ${var. token survives filtering.
				The module would otherwise start and mint every CPI with no facility of origin. The
				substring is "{var." so that neither Maven nor Ant reads it as a property reference.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-antrun-plugin</artifactId>
				<version>3.1.0</version>
				<executions>
					<execution>
						<id>no-unresolved-variables</id>
						<phase>process-resources</phase>
						<goals>
							<goal>run</goal>
						</goals>
						<configuration>
							<target>
								<fail message="unresolved variable in target/classes/liberiaemr-uuids.properties; declare it in the filtered content layers">
									<condition>
										<resourcecontains resource="${project.build.outputDirectory}/liberiaemr-uuids.properties" substring="{var."/>
									</condition>
								</fail>
							</target>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!--
				maven-parent-openmrs-module 1.1.1 adds powermock-api-mockito 1.5 to every test
				classpath. Its jar registers a Mockito 1 MockMaker (CglibMockMaker), which does not
				exist in the Mockito that openmrs-test 2.6.9 brings, so every context-sensitive test
				failed in setup before it ran (hence LiberiaEMRDaoTest's @Ignore). No test here uses
				PowerMock; openmrs-test's own powermock-api-mockito2 stays.
				The opens are what OpenMRS's Hibernate proxies need on the JDK 17 that CI and the
				image build use.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<argLine>--add-opens java.base/java.lang=ALL-UNNAMED --add-opens java.base/java.util=ALL-UNNAMED --add-opens java.base/java.lang.reflect=ALL-UNNAMED --add-opens java.base/java.text=ALL-UNNAMED</argLine>
					<classpathDependencyExcludes>
						<classpathDependencyExclude>org.powermock:powermock-api-mockito</classpathDependencyExclude>
					</classpathDependencyExcludes>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
