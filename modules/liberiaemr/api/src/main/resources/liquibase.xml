<?xml version="1.0" encoding="UTF-8"?>
 
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog/1.9"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog/1.9
                  http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-1.9.xsd">
 
	<changeSet id="liberiaemr-2024-01-01-create-password-reset-token" author="mutajonathan">
		<preConditions onFail="MARK_RAN">
			<not><tableExists tableName="liberiaemr_password_reset_token"/></not>
		</preConditions>
		<comment>
			Creating the liberiaemr_password_reset_token table for storing
			password reset tokens with expiry and void support.
		</comment>
		<createTable tableName="liberiaemr_password_reset_token">
			<column name="token_id" type="int" autoIncrement="true">
				<constraints primaryKey="true" nullable="false"/>
			</column>
			<column name="user_id" type="int">
				<constraints nullable="false"/>
			</column>
			<column name="token" type="varchar(255)">
				<constraints nullable="false" unique="true"/>
			</column>
			<column name="date_created" type="datetime">
				<constraints nullable="false"/>
			</column>
			<column name="date_expires" type="datetime">
				<constraints nullable="false"/>
			</column>
			<column name="voided" type="boolean" defaultValueBoolean="false">
				<constraints nullable="false"/>
			</column>
		</createTable>
		<addForeignKeyConstraint constraintName="liberiaemr_prt_user_fk"
			baseTableName="liberiaemr_password_reset_token" baseColumnNames="user_id"
			referencedTableName="users" referencedColumnNames="user_id"/>
		<createIndex indexName="liberiaemr_prt_token_idx" tableName="liberiaemr_password_reset_token">
			<column name="token"/>
		</createIndex>
	</changeSet>
 
	<changeSet id="liberiaemr-2026-09-23-create-sync-conflict-decision" author="liberiaemr">
		<preConditions onFail="MARK_RAN">
			<not><tableExists tableName="liberiaemr_sync_conflict_decision"/></not>
		</preConditions>
		<comment>Decisions on sync conflicts at central. Append-only: a later decision supersedes.</comment>
		<createTable tableName="liberiaemr_sync_conflict_decision">
			<column name="decision_id" type="int" autoIncrement="true">
				<constraints primaryKey="true" nullable="false"/>
			</column>
			<column name="conflict_id" type="bigint">
				<constraints nullable="false"/>
			</column>
			<column name="identifier" type="varchar(255)">
				<constraints nullable="false"/>
			</column>
			<column name="table_name" type="varchar(64)">
				<constraints nullable="false"/>
			</column>
			<column name="decision" type="varchar(50)">
				<constraints nullable="false"/>
			</column>
			<column name="reason" type="varchar(500)">
				<constraints nullable="false"/>
			</column>
			<column name="decided_by" type="int">
				<constraints nullable="false"/>
			</column>
			<column name="date_decided" type="datetime">
				<constraints nullable="false"/>
			</column>
			<column name="date_applied" type="datetime"/>
			<column name="date_apply_failed" type="datetime"/>
			<column name="apply_error" type="varchar(255)"/>
			<column name="uuid" type="char(38)">
				<constraints nullable="false" unique="true"/>
			</column>
		</createTable>
		<addForeignKeyConstraint constraintName="liberiaemr_scd_decided_by_fk"
			baseTableName="liberiaemr_sync_conflict_decision" baseColumnNames="decided_by"
			referencedTableName="users" referencedColumnNames="user_id"/>
		<createIndex indexName="liberiaemr_scd_conflict_idx" tableName="liberiaemr_sync_conflict_decision">
			<column name="conflict_id"/>
		</createIndex>
	</changeSet>

	<!--
		The identity schema (sync-eip.md 2.5.3) exists only at central, created by initdb. Where
		it is missing these changesets are skipped and tried again at the next start, so a
		facility runs the same module untouched.
	-->
	<changeSet id="liberiaemr-2026-09-25-identity-cpi" author="liberiaemr">
		<preConditions onFail="CONTINUE">
			<sqlCheck expectedResult="1">SELECT COUNT(*) FROM information_schema.schemata WHERE schema_name = 'openmrs_identity'</sqlCheck>
			<not><tableExists schemaName="openmrs_identity" tableName="cpi"/></not>
		</preConditions>
		<comment>Central Person Identifiers. An aliased CPI keeps its row and points at its primary.</comment>
		<createTable schemaName="openmrs_identity" tableName="cpi">
			<column name="cpi_id" type="int" autoIncrement="true">
				<constraints primaryKey="true" nullable="false"/>
			</column>
			<column name="cpi" type="char(36)">
				<constraints nullable="false" unique="true"/>
			</column>
			<column name="code" type="char(16)">
				<constraints nullable="false" unique="true"/>
			</column>
			<column name="primary_cpi_id" type="int"/>
			<column name="date_created" type="datetime">
				<constraints nullable="false"/>
			</column>
			<column name="date_changed" type="datetime"/>
			<column name="change_reason" type="varchar(500)"/>
		</createTable>
		<addForeignKeyConstraint constraintName="cpi_primary_fk"
			baseTableSchemaName="openmrs_identity" baseTableName="cpi" baseColumnNames="primary_cpi_id"
			referencedTableSchemaName="openmrs_identity" referencedTableName="cpi" referencedColumnNames="cpi_id"/>
	</changeSet>

	<changeSet id="liberiaemr-2026-09-25-identity-patient-link" author="liberiaemr">
		<preConditions onFail="CONTINUE">
			<sqlCheck expectedResult="1">SELECT COUNT(*) FROM information_schema.schemata WHERE schema_name = 'openmrs_identity'</sqlCheck>
			<not><tableExists schemaName="openmrs_identity" tableName="patient_link"/></not>
		</preConditions>
		<comment>Each patient record central receives, and the CPI minted for it. Never deleted.</comment>
		<createTable schemaName="openmrs_identity" tableName="patient_link">
			<column name="link_id" type="int" autoIncrement="true">
				<constraints primaryKey="true" nullable="false"/>
			</column>
			<column name="patient_uuid" type="char(38)">
				<constraints nullable="false" unique="true"/>
			</column>
			<column name="cpi_id" type="int">
				<constraints nullable="false"/>
			</column>
			<column name="facility_location_uuid" type="char(38)"/>
			<column name="basis" type="varchar(30)">
				<constraints nullable="false"/>
			</column>
			<column name="date_created" type="datetime">
				<constraints nullable="false"/>
			</column>
		</createTable>
		<addForeignKeyConstraint constraintName="patient_link_cpi_fk"
			baseTableSchemaName="openmrs_identity" baseTableName="patient_link" baseColumnNames="cpi_id"
			referencedTableSchemaName="openmrs_identity" referencedTableName="cpi" referencedColumnNames="cpi_id"/>
	</changeSet>

	<changeSet id="liberiaemr-2026-09-25-identity-cpi-event" author="liberiaemr">
		<preConditions onFail="CONTINUE">
			<sqlCheck expectedResult="1">SELECT COUNT(*) FROM information_schema.schemata WHERE schema_name = 'openmrs_identity'</sqlCheck>
			<not><tableExists schemaName="openmrs_identity" tableName="cpi_event"/></not>
		</preConditions>
		<comment>Every mint, alias and reversal, with who and why. Append-only.</comment>
		<createTable schemaName="openmrs_identity" tableName="cpi_event">
			<column name="event_id" type="int" autoIncrement="true">
				<constraints primaryKey="true" nullable="false"/>
			</column>
			<column name="cpi_id" type="int">
				<constraints nullable="false"/>
			</column>
			<column name="kind" type="varchar(30)">
				<constraints nullable="false"/>
			</column>
			<column name="primary_before" type="int"/>
			<column name="primary_after" type="int"/>
			<column name="reason" type="varchar(500)"/>
			<column name="actor_user_id" type="int"/>
			<column name="date_created" type="datetime">
				<constraints nullable="false"/>
			</column>
		</createTable>
		<addForeignKeyConstraint constraintName="cpi_event_cpi_fk"
			baseTableSchemaName="openmrs_identity" baseTableName="cpi_event" baseColumnNames="cpi_id"
			referencedTableSchemaName="openmrs_identity" referencedTableName="cpi" referencedColumnNames="cpi_id"/>
	</changeSet>

	<changeSet id="liberiaemr-2026-09-25-identity-match-review" author="liberiaemr">
		<preConditions onFail="CONTINUE">
			<sqlCheck expectedResult="1">SELECT COUNT(*) FROM information_schema.schemata WHERE schema_name = 'openmrs_identity'</sqlCheck>
			<not><tableExists schemaName="openmrs_identity" tableName="match_review"/></not>
		</preConditions>
		<comment>Possible matches that need a person to decide (the middle band of ADR 0005).</comment>
		<createTable schemaName="openmrs_identity" tableName="match_review">
			<column name="review_id" type="int" autoIncrement="true">
				<constraints primaryKey="true" nullable="false"/>
			</column>
			<column name="patient_uuid" type="char(38)">
				<constraints nullable="false"/>
			</column>
			<column name="candidate_patient_uuid" type="char(38)">
				<constraints nullable="false"/>
			</column>
			<column name="reason" type="varchar(255)">
				<constraints nullable="false"/>
			</column>
			<column name="status" type="varchar(20)">
				<constraints nullable="false"/>
			</column>
			<column name="date_created" type="datetime">
				<constraints nullable="false"/>
			</column>
			<column name="decision" type="varchar(20)"/>
			<column name="decided_by" type="int"/>
			<column name="date_decided" type="datetime"/>
		</createTable>
		<createIndex schemaName="openmrs_identity" indexName="match_review_patient_idx" tableName="match_review">
			<column name="patient_uuid"/>
		</createIndex>
	</changeSet>

	<changeSet id="liberiaemr-2026-09-27-mfl-sync-run" author="liberiaemr">
		<preConditions onFail="MARK_RAN">
			<not><tableExists tableName="liberiaemr_mfl_sync_run"/></not>
		</preConditions>
		<comment>One row per MFL sync run (ADR 0009, LE-321). The counts on a dry run are what would happen.</comment>
		<createTable tableName="liberiaemr_mfl_sync_run">
			<column name="run_id" type="int" autoIncrement="true">
				<constraints primaryKey="true" nullable="false"/>
			</column>
			<column name="dry_run" type="boolean">
				<constraints nullable="false"/>
			</column>
			<column name="run_trigger" type="varchar(20)">
				<constraints nullable="false"/>
			</column>
			<column name="status" type="varchar(20)">
				<constraints nullable="false"/>
			</column>
			<column name="started_by" type="int"/>
			<column name="date_started" type="datetime">
				<constraints nullable="false"/>
			</column>
			<column name="date_finished" type="datetime"/>
			<column name="created" type="int" defaultValueNumeric="0">
				<constraints nullable="false"/>
			</column>
			<column name="updated" type="int" defaultValueNumeric="0">
				<constraints nullable="false"/>
			</column>
			<column name="retired" type="int" defaultValueNumeric="0">
				<constraints nullable="false"/>
			</column>
			<column name="unretired" type="int" defaultValueNumeric="0">
				<constraints nullable="false"/>
			</column>
			<column name="unchanged" type="int" defaultValueNumeric="0">
				<constraints nullable="false"/>
			</column>
			<column name="failed" type="int" defaultValueNumeric="0">
				<constraints nullable="false"/>
			</column>
			<column name="warnings" type="int" defaultValueNumeric="0">
				<constraints nullable="false"/>
			</column>
			<column name="message" type="varchar(1000)"/>
			<column name="uuid" type="char(38)">
				<constraints nullable="false" unique="true"/>
			</column>
		</createTable>
		<addForeignKeyConstraint constraintName="liberiaemr_mfl_run_started_by_fk"
			baseTableName="liberiaemr_mfl_sync_run" baseColumnNames="started_by"
			referencedTableName="users" referencedColumnNames="user_id"/>
	</changeSet>

	<changeSet id="liberiaemr-2026-09-27-mfl-sync-run-item" author="liberiaemr">
		<preConditions onFail="MARK_RAN">
			<not><tableExists tableName="liberiaemr_mfl_sync_run_item"/></not>
		</preConditions>
		<comment>
			The per-location changes, warnings and errors of an MFL sync run. A location that is
			unchanged and has no warning gets no row. changes and warnings hold JSON arrays.
		</comment>
		<createTable tableName="liberiaemr_mfl_sync_run_item">
			<column name="item_id" type="int" autoIncrement="true">
				<constraints primaryKey="true" nullable="false"/>
			</column>
			<column name="run_id" type="int">
				<constraints nullable="false"/>
			</column>
			<column name="action" type="varchar(20)">
				<constraints nullable="false"/>
			</column>
			<column name="location_level" type="varchar(20)"/>
			<column name="mfl_uid" type="varchar(50)">
				<constraints nullable="false"/>
			</column>
			<column name="mfl_code" type="varchar(100)"/>
			<column name="location_uuid" type="char(38)"/>
			<column name="name" type="varchar(255)"/>
			<column name="changes" type="text"/>
			<column name="warnings" type="text"/>
			<column name="error" type="varchar(1000)"/>
		</createTable>
		<addForeignKeyConstraint constraintName="liberiaemr_mfl_run_item_run_fk"
			baseTableName="liberiaemr_mfl_sync_run_item" baseColumnNames="run_id"
			referencedTableName="liberiaemr_mfl_sync_run" referencedColumnNames="run_id"/>
		<createIndex indexName="liberiaemr_mfl_run_item_action_idx" tableName="liberiaemr_mfl_sync_run_item">
			<column name="run_id"/>
			<column name="action"/>
		</createIndex>
	</changeSet>

	<changeSet id="liberiaemr-2026-09-25-identity-link-national-id" author="liberiaemr">
		<preConditions onFail="CONTINUE">
			<sqlCheck expectedResult="1">SELECT COUNT(*) FROM information_schema.schemata WHERE schema_name = 'openmrs_identity'</sqlCheck>
			<not><columnExists schemaName="openmrs_identity" tableName="patient_link" columnName="national_id"/></not>
		</preConditions>
		<comment>The National ID the rule last ran against, so one added or corrected later is checked again.</comment>
		<addColumn schemaName="openmrs_identity" tableName="patient_link">
			<column name="national_id" type="varchar(50)"/>
		</addColumn>
	</changeSet>

	<!--
		Links minted before this change hold the ROOT of the identifier location's tree as their
		facility, which under the MFL hierarchy (ADR 0009) is the county or the country. This
		recomputes every link with the rule new links are minted with: the nearest ancestor-or-self
		tagged Health Facility (IdentityService, FacilityOfOrigin). It is Java, not SQL, so the rule
		exists once in the module; it writes only rows whose value changes, so it is idempotent.
		Like the changesets above it is skipped, and not marked ran, where the identity schema is
		missing: every facility. It touches only openmrs_identity, which no binlog reader follows.
	-->
	<changeSet id="liberiaemr-2026-09-30-identity-facility-of-origin" author="liberiaemr">
		<preConditions onFail="CONTINUE">
			<sqlCheck expectedResult="1">SELECT COUNT(*) FROM information_schema.schemata WHERE schema_name = 'openmrs_identity'</sqlCheck>
			<tableExists schemaName="openmrs_identity" tableName="patient_link"/>
		</preConditions>
		<comment>Recompute patient_link.facility_location_uuid as the nearest Health Facility, not the tree's root.</comment>
		<customChange class="org.openmrs.module.liberiaemr.identity.FacilityOfOriginBackfill"/>
	</changeSet>

	<!--
		The audit log viewer (MOH ICT SOP B3) pages auditlog_audit_log, the auditlog module's table,
		by date, type and parent row. The module creates no index on any of them, so every filtered
		page and every child count was a full scan of a table that grows without limit. These are
		indexes only: the table and its rows stay the auditlog module's.

		onFail="CONTINUE", not MARK_RAN: this module is only aware of auditlog, which may be installed
		later. Until the table exists the change set is skipped and tried again on the next start.
	-->
	<changeSet id="liberiaemr-2026-09-30-auditlog-date-index" author="liberiaemr">
		<preConditions onFail="CONTINUE">
			<tableExists tableName="auditlog_audit_log"/>
			<not><indexExists indexName="liberiaemr_auditlog_date_idx"/></not>
		</preConditions>
		<comment>Index auditlog_audit_log.date_created for the audit log viewer's date filter</comment>
		<createIndex indexName="liberiaemr_auditlog_date_idx" tableName="auditlog_audit_log">
			<column name="date_created"/>
		</createIndex>
	</changeSet>

	<changeSet id="liberiaemr-2026-09-30-auditlog-type-index" author="liberiaemr">
		<preConditions onFail="CONTINUE">
			<tableExists tableName="auditlog_audit_log"/>
			<not><indexExists indexName="liberiaemr_auditlog_type_idx"/></not>
		</preConditions>
		<comment>Index auditlog_audit_log.type for the audit log viewer's type filter and type list</comment>
		<createIndex indexName="liberiaemr_auditlog_type_idx" tableName="auditlog_audit_log">
			<column name="type"/>
		</createIndex>
	</changeSet>

	<changeSet id="liberiaemr-2026-09-30-auditlog-parent-index" author="liberiaemr">
		<preConditions onFail="CONTINUE">
			<tableExists tableName="auditlog_audit_log"/>
			<not><indexExists indexName="liberiaemr_auditlog_parent_idx"/></not>
		</preConditions>
		<comment>Index auditlog_audit_log.parent_auditlog_id for the audit log viewer's child rows</comment>
		<createIndex indexName="liberiaemr_auditlog_parent_idx" tableName="auditlog_audit_log">
			<column name="parent_auditlog_id"/>
		</createIndex>
	</changeSet>

	<!--
		The LIS (OpenELIS) integration is out of scope (LE-380), so labonfhir's scheduled tasks stay
		off. runAlways, because labonfhir's own liquibase inserts them with start_on_startup=1 and
		an admin may switch them on. It has to happen here, not only in LiberiaEMRActivator: the
		scheduler starts tasks on a background thread after the context refresh, at the same time
		as module activators run, so a task the activator shuts down can still be mid-run and save
		its started/start_on_startup flags back. Module liquibase runs before that refresh, so the
		scheduler never sees these tasks as start-on-startup. config.xml is aware of labonfhir, so
		its rows exist by now. Remove this when the LIS integration is taken on.
	-->
	<changeSet id="liberiaemr-2026-10-03-labonfhir-tasks-off" author="liberiaemr" runAlways="true">
		<preConditions onFail="CONTINUE">
			<tableExists tableName="scheduler_task_config"/>
		</preConditions>
		<comment>Keep labonfhir's scheduled tasks from starting: the LIS integration is out of scope</comment>
		<update tableName="scheduler_task_config">
			<column name="started" valueBoolean="false"/>
			<column name="start_on_startup" valueBoolean="false"/>
			<where>schedulable_class LIKE 'org.openmrs.module.labonfhir.%'</where>
		</update>
	</changeSet>

</databaseChangeLog>
