<?xml version="1.0" encoding="UTF-8"?>

<module configVersion="1.2">
	
	<!-- Base Module Properties -->
	<id>${project.parent.artifactId}</id>
	<name>${project.parent.name}</name>
	<version>${project.parent.version}</version>
	<package>org.openmrs.module.liberiaemr</package>
	<author>mutajonathan</author>
	<description>
			${project.parent.description}
	</description>

	<activator>org.openmrs.module.liberiaemr.LiberiaEMRActivator</activator>
	
	<!-- /Base Module Properties -->
	
	<require_version>2.6.9</require_version>

	<filter>
		<filter-name>clinicalResponseFilter</filter-name>
		<filter-class>org.openmrs.module.liberiaemr.web.moduleaccess.ClinicalResponseFilter</filter-class>
	</filter>
	<filter-mapping>
		<filter-name>clinicalResponseFilter</filter-name>
		<url-pattern>/*</url-pattern>
	</filter-mapping>
	<filter>
		<filter-name>orderCareSettingFilter</filter-name>
		<filter-class>org.openmrs.module.liberiaemr.web.moduleaccess.OrderCareSettingFilter</filter-class>
	</filter>
	<filter-mapping>
		<filter-name>orderCareSettingFilter</filter-name>
		<url-pattern>/*</url-pattern>
	</filter-mapping>
	<filter>
		<filter-name>billingVisitFilter</filter-name>
		<filter-class>org.openmrs.module.liberiaemr.web.moduleaccess.BillingVisitFilter</filter-class>
	</filter>
	<filter-mapping>
		<filter-name>billingVisitFilter</filter-name>
		<url-pattern>/*</url-pattern>
	</filter-mapping>

	<!-- Required Modules -->
	<!--
		The MINIMUM webservices.rest, kept equal to webservicesRestVersion in the parent pom —
		the version this module is COMPILED against. distro.properties pins what the
		distribution runs (3.5.0), which clears this floor.
	-->
	<require_modules>
		<require_module version="3.0.0">
			org.openmrs.module.webservices.rest
		</require_module>
		<require_module version="4.0.0">
			org.openmrs.event
		</require_module>
		<require_module version="2.1.0">
			org.bahmni.module.appointments
		</require_module>
	</require_modules>
	
	<!--
		auditlog: aware of, never required. The audit log viewer's endpoint
		(/ws/rest/v1/liberiaemr/auditlog) reads the auditlog module's table when the module runs,
		and answers 503 when it does not; this module starts either way. Being aware of it also
		starts auditlog first, so its table exists before our liquibase indexes it.

		labonfhir: aware of, never required. Starting it first means its liquibase has created
		its scheduled tasks before LabOnFhirTasks turns them off (the LIS integration is out of
		scope, LE-380).
	-->
	<aware_of_modules>
		<aware_of_module>org.openmrs.module.legacyui</aware_of_module>
		<aware_of_module>org.openmrs.module.auditlog</aware_of_module>
		<aware_of_module>org.openmrs.module.labonfhir</aware_of_module>
	</aware_of_modules>

	<!-- Required Global Properties -->

	<!-- Appointment Integration Configuration -->
	<globalProperty>
		<property>liberiaemr.remoteHistory.excludedConceptUuids</property>
		<defaultValue></defaultValue>
		<description>
			Central only: comma-separated concept UUIDs the MOH names as sensitive.
			A condition, allergy, medication, immunisation or programme coded with one is never sent to
			another facility.
		</description>
	</globalProperty>
	<globalProperty>
		<property>liberiaemr.nextContactDateConceptUuid</property>
		<defaultValue></defaultValue>
		<description>
			The concept UUID for the "Next Contact Date" (e.g., CIEL 5096) observation.
			When an observation is created with this concept, a corresponding appointment will be scheduled automatically.
		</description>
	</globalProperty>
	<globalProperty>
		<property>liberiaemr.defaultAppointmentServiceUuid</property>
		<defaultValue></defaultValue>
		<description>
			The UUID of the default Appointment Service to assign to auto-generated appointments.
			If left blank, the appointment will be created without a specific service.
		</description>
	</globalProperty>

	<!-- Email / SMTP Configuration -->
	<globalProperty>
		<property>liberiaemr.email.host</property>
		<defaultValue>localhost</defaultValue>
		<description>
			SMTP server hostname for sending password reset emails.
			Normally set from LIBERIAEMR_SMTP_HOST in the deployment environment;
			this property is the fallback for a developer changing it on a live box.
			Use 'localhost' for a local relay, or an external provider
			(e.g., smtp.sendgrid.net, email-smtp.us-east-1.amazonaws.com).
		</description>
	</globalProperty>
	<globalProperty>
		<property>liberiaemr.email.port</property>
		<defaultValue>25</defaultValue>
		<description>
			SMTP server port. Common values: 25 (local), 465 (SSL), 587 (TLS/STARTTLS).
		</description>
	</globalProperty>
	<globalProperty>
		<property>liberiaemr.email.username</property>
		<defaultValue></defaultValue>
		<description>
			SMTP username. Normally set from LIBERIAEMR_SMTP_USER.
			Leave empty for local open relays.
		</description>
	</globalProperty>
	<globalProperty>
		<property>liberiaemr.email.password</property>
		<defaultValue></defaultValue>
		<description>
			SMTP password. DEVELOPMENT FALLBACK ONLY, and never seeded from
			versioned content: in a deployment this comes from
			LIBERIAEMR_SMTP_PASSWORD_FILE (a path read verbatim) or
			LIBERIAEMR_SMTP_PASSWORD. Leave empty for local open relays.
		</description>
	</globalProperty>
	<globalProperty>
		<property>liberiaemr.email.from</property>
		<defaultValue>noreply@liberiaemr.org</defaultValue>
		<description>
			The "From" email address used in password reset emails.
			Normally set from LIBERIAEMR_SMTP_FROM.
		</description>
	</globalProperty>

	<!-- Frontend URL -->
	<globalProperty>
		<property>liberiaemr.frontend.url</property>
		<defaultValue>http://localhost:8080/openmrs/spa</defaultValue>
		<description>
			Base URL of the frontend SPA used to construct password reset links in emails.
			Normally set from LIBERIAEMR_FRONTEND_URL. A trailing slash is stripped.
			Examples: http://localhost:8080/openmrs/spa, https://liberiaemr.org/openmrs/spa
		</description>
	</globalProperty>

	<!-- Password Reset Token Expiry -->
	<globalProperty>
		<property>liberiaemr.passwordReset.tokenExpiryHours</property>
		<defaultValue>2</defaultValue>
		<description>
			Number of hours a password reset token remains valid before expiring.
		</description>
	</globalProperty>

	<!-- Central Person Identifier (sync-eip.md 2.5). Active only where the identity schema exists. -->
	<globalProperty>
		<property>liberiaemr.identity.nationalIdTypeUuid</property>
		<defaultValue></defaultValue>
		<description>
			The patient identifier type whose exact match links two records to one person,
			once sex and date of birth agree (ADR 0005). Set by the national content package
			to the Liberia National ID; empty mints CPIs without linking.
		</description>
	</globalProperty>
	<globalProperty>
		<property>liberiaemr.identity.dobToleranceDays</property>
		<defaultValue>0</defaultValue>
		<description>
			How far apart two documented dates of birth may be and still agree for the National
			ID rule. When either date is estimated only the year is compared.
		</description>
	</globalProperty>
	<globalProperty>
		<property>liberiaemr.identity.batchSize</property>
		<defaultValue>200</defaultValue>
		<description>
			How many newly received patients the identity task assigns a CPI on each run.
		</description>
	</globalProperty>
	<globalProperty>
		<property>liberiaemr.identity.intervalSeconds</property>
		<defaultValue>60</defaultValue>
		<description>
			How often the identity task runs, in seconds (at least 10). A change takes effect without
			a restart.
		</description>
	</globalProperty>

	<!--
		MOH Master Facility List sync (ADR 0009). Operator settings, edited from the MFL sync page.
		Declared here and never seeded by Initializer, which would undo an edit on every boot.
		The credentials and the allowed MFL hosts are NOT global properties: they come from
		LIBERIAEMR_MFL_USERNAME, LIBERIAEMR_MFL_PASSWORD_FILE (or LIBERIAEMR_MFL_PASSWORD) and
		LIBERIAEMR_MFL_ALLOWED_HOSTS in the deployment environment.
	-->
	<globalProperty>
		<property>liberiaemr.mfl.enabled</property>
		<defaultValue>false</defaultValue>
		<description>
			Whether the daily MFL sync runs. Manual runs from the MFL sync page are allowed whenever
			MFL credentials are configured, whatever this says.
		</description>
	</globalProperty>
	<globalProperty>
		<property>liberiaemr.mfl.url</property>
		<defaultValue>https://dhis2.moh.gov.lr/mfl</defaultValue>
		<description>
			The MFL's DHIS2 instance root, without /api. Its host must be one of
			LIBERIAEMR_MFL_ALLOWED_HOSTS (default dhis2.moh.gov.lr), or no request is sent: the MFL
			credentials go only to an allowed host.
		</description>
	</globalProperty>
	<globalProperty>
		<property>liberiaemr.mfl.schedule.time</property>
		<defaultValue>02:00</defaultValue>
		<description>
			The daily MFL sync's time of day, HH:MM in 24-hour time, Africa/Monrovia. A change
			takes effect without a restart.
		</description>
	</globalProperty>

	<!-- Future SMS MFA Provisions (not yet implemented) -->
	<globalProperty>
		<property>liberiaemr.sms.provider.url</property>
		<defaultValue></defaultValue>
		<description>
			[Future] Base URL for the SMS gateway API used for MFA OTP delivery.
		</description>
	</globalProperty>
	<globalProperty>
		<property>liberiaemr.sms.provider.apiKey</property>
		<defaultValue></defaultValue>
		<description>
			[Future] API key for the configured SMS gateway provider.
		</description>
	</globalProperty>

	<globalProperty>
		<property>liberiaemr.remoteHistory.maxAgeHours</property>
		<defaultValue>24</defaultValue>
		<description>
			Facility (LE-384, ADR 0013): how old, in hours, an imported patient's cached history from
			central may be before opening their chart refreshes it. Offline, the cache is served
			whatever its age, and the chart shows that age.
		</description>
	</globalProperty>

	<!-- Internationalization -->
	<!-- All message codes should start with @MODULE_ID@.* -->
	<messages>
		<lang>en</lang>
		<file>messages.properties</file>
	</messages>
	<messages>
		<lang>fr</lang>
		<file>messages_fr.properties</file>
	</messages>
	<messages>
		<lang>es</lang>
		<file>messages_es.properties</file>
	</messages>
	<!-- /Internationalization -->
	
</module>
