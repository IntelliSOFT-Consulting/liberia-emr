### LiberiaEMR ###
# scripts/build/ is SOURCE, not a Gradle/NetBeans output directory. The generic `build/`
# rule above matched it at any depth, so every build script in the repository — the ones
# README.md, CONTRIBUTING.md and both GitHub workflows invoke by path — was silently
# untracked and missing from a fresh clone.
!scripts/build/

# Real environment files — only the .example templates are committed.
*.env
!*.env.example

# TLS material is mounted at run time, never committed.
*.pem
*.key
*.p12
*.pfx
*.jks

# CIEL dictionary exports: large, licensed, fetched at build time.
content-packages/*/configuration/backend_configuration/ocl/*.zip

# Generated build inputs — regenerated from distro.properties.
distribution/frontend/spa-assemble-config.json
distribution/frontend/config/
distribution/backend/modules/

# Upgrade-test fixtures are generated, and must never contain production data.
qa/upgrade/fixtures/*.sql
qa/upgrade/fixtures/*.sql.gz

# Node & Yarn
node_modules/
dist/
.turbo/
.cache/
**/.pnp.*
**/.yarn/*
!**/.yarn/patches
!**/.yarn/plugins
!**/.yarn/releases
!**/.yarn/sdks
!**/.yarn/versions

# Throwaway self-signed TLS material generated by qa/upgrade/run-clean-install.sh.
# Regenerated per run and removed by its cleanup trap; never a real certificate.
qa/upgrade/.ci-certs/
# The upgrade test's working files (run-upgrade.sh): concept list and before/after snapshots.
qa/upgrade/.upgrade-work/
qa/upgrade/initializer-failure.log

# Report data-set dumps written by qa/reporting/run-stack-check.sh --dump-dir (synthetic figures).
qa/reporting/.out/
__pycache__/

## cypess local environment
cypress/videos/
cypress/screenshots/
# Cypress
qa/e2e/cypress.env.json
qa/e2e/node_modules/
qa/e2e/cypress/screenshots/
qa/e2e/cypress/videos/
qa/e2e/cypress/downloads/


#Ansible
ansible/inventory.ini
ansible/central-server.vars.yml



# LiberiaEMR DB backups — scripts/backup/
# Everything a server renders or keeps there stays out of git: env files with credentials, the
# rendered scripts cron runs, rclone config, keys, and older copies an operator leaves behind.
# Only the templates, the example env, render.sh and the README are tracked; list a new
# tracked kind here, or it is ignored. Note: git overwrites an ignored file without asking
# when a commit adds a file of the same name, so never commit a name a server renders to.
scripts/backup/*
!scripts/backup/README.md
!scripts/backup/render.sh
!scripts/backup/*-template.sh
!scripts/backup/*.env.example
