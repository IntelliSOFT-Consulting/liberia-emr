# central-server.vars.yml — TEMPLATE ONLY.
#
# Copy to central-server.vars.yml and fill in real values:
#   cp central-server.vars.yml.example central-server.vars.yml
#
# central-server.vars.yml is git-ignored and MUST NOT be committed — it's what
# keeps a specific server hostname and repo location out of the (public) repo.

repo_url: <repo_url>
repo_dest: <add_repo_dir>
certbot_domain: <add_the_cert_bot_domain>
certbot_email: <admin_email>
tls_cert_dir: <add_the_cert_bot_dir>

# Optional (LE-368). The PUBLIC half of the CI-only keypair that the "Update central dev
# environment" job in .github/workflows/ci.yml deploys with; its private half is the
# CENTRAL_DEV_SSH_PRIVATE_KEY repository secret. Changing it and re-running the playbook
# replaces the old key, so a rotation revokes it; unsetting it removes the key. Leave it unset
# on a server CI must not deploy to. A plain key line only, with no options before it.
# Exception: on a server whose CI key was added before the playbook marked it, the old
# unmarked line cannot be recognised, so rotating OR unsetting leaves it authorized until it
# is also listed in ci_deploy_revoked_keys below.
# ci_deploy_public_key: "ssh-ed25519 AAAA... liberia-emr-ci-central-dev"
#
# Optional. Public keys that must no longer log in, removed whatever comment they carry.
# Needed once on a server whose CI key was added before the playbook marked it: when that
# key is rotated or ci_deploy_public_key is unset, list the OLD key here, or its unmarked
# line stays authorized.
# ci_deploy_revoked_keys:
#   - "ssh-ed25519 AAAA... liberia-emr-ci-central-dev"
