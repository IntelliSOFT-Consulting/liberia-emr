{
  "name": "@liberiaemr/esm-liberia-login-app",
  "version": "10.0.0",
  "license": "MPL-2.0",
  "description": "The login microfrontend for LiberiaEMR",
  "browser": "dist/liberiaemr-esm-liberia-login-app.js",
  "main": "src/index.ts",
  "source": true,
  "scripts": {
    "start": "openmrs develop",
    "start:dev": "openmrs develop --backend https://liberiaemrfacilitydev.intellisoftkenya.com --config-file ../../distribution/frontend/config/config-national.json --config-file ../../distribution/frontend/config/config-mch.json",
    "serve": "rspack serve --mode=development",
    "debug": "npm run serve",
    "test": "cross-env TZ=UTC vitest run --passWithNoTests",
    "test:watch": "cross-env TZ=UTC vitest watch",
    "build": "rspack --mode=production",
    "clean": "git clean -fdX -- dist",
    "build:development": "rspack --mode=development",
    "analyze": "rspack --mode=production --env analyze=true",
    "typescript": "tsc",
    "lint": "eslint src",
    "extract-translations": "i18next 'src/**/*.component.tsx' 'src/**/*.extension.tsx' 'src/**/*.modal.tsx' 'src/**/*.resource.ts' --config='../../../tools/i18next-parser.config.js'",
    "coverage": "cross-env TZ=UTC vitest run --coverage --passWithNoTests"
  },
  "keywords": [
    "openmrs",
    "microfrontends"
  ],
  "browserslist": [
    "extends browserslist-config-openmrs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openmrs/openmrs-esm-core.git"
  },
  "bugs": {
    "url": "https://github.com/openmrs/openmrs-esm-core/issues"
  },
  "homepage": "https://github.com/openmrs/openmrs-esm-core#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.6.0",
    "lodash-es": "^4.17.21",
    "react-hook-form": "^7.52.2",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "@carbon/react": "1.x",
    "@openmrs/esm-framework": "10.x",
    "react": "18.x",
    "react-dom": "18.x",
    "react-i18next": "16.x",
    "react-router-dom": "6.x",
    "rxjs": "6.x",
    "swr": "2.x"
  },
  "devDependencies": {
    "@carbon/react": "^1.92.1",
    "@openmrs/esm-framework": "10.0.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "@types/react": "^18.2.65",
    "@types/react-dom": "^18.2.22",
    "@vitest/coverage-v8": "^4.1.2",
    "cross-env": "^10.1.0",
    "happy-dom": "^20.6.0",
    "openmrs": "10.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.0.0",
    "react-router-dom": "^6.3.0",
    "rxjs": "^6.5.3",
    "swr": "2.2.5",
    "typescript": "^5.6.0",
    "vitest": "^4.1.2"
  },
  "resolutions": {
    "@openmrs/rspack-config": "10.0.0",
    "@openmrs/webpack-config": "10.0.0",
    "@openmrs/esm-app-shell": "10.0.0",
    "@openmrs/esm-framework": "10.0.0"
  }
}
