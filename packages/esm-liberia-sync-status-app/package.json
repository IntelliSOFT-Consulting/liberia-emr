{
  "name": "@liberiaemr/esm-liberia-sync-status-app",
  "version": "1.0.0",
  "license": "MPL-2.0",
  "description": "National sync status page for LiberiaEMR: which facilities are sending, and what is waiting at central",
  "browser": "dist/liberiaemr-esm-liberia-sync-status-app.js",
  "main": "src/index.ts",
  "source": true,
  "scripts": {
    "start": "openmrs develop",
    "start:local": "openmrs develop --backend http://localhost:8085 --port 8084",
    "serve": "rspack serve --mode=development",
    "build": "rspack --mode production",
    "analyze": "rspack --mode=production --env analyze=true",
    "lint": "eslint src --ext ts,tsx",
    "typescript": "tsc",
    "test": "jest --config jest.config.js",
    "verify": "yarn typescript && yarn test",
    "extract-translations": "i18next 'src/**/*.component.tsx'"
  },
  "browserslist": [
    "extends browserslist-config-openmrs"
  ],
  "keywords": [
    "openmrs",
    "microfrontends",
    "liberia",
    "sync"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@carbon/react": "^1.71.0",
    "swr": "^2.2.5"
  },
  "peerDependencies": {
    "@openmrs/esm-framework": "*",
    "dayjs": "1.x",
    "react": "18.x",
    "react-i18next": "11.x",
    "react-router-dom": "6.x",
    "rxjs": "6.x"
  },
  "devDependencies": {
    "@openmrs/esm-framework": "10.0.0",
    "@rspack/cli": "^1.0.0",
    "@rspack/core": "^1.0.0",
    "@swc/jest": "^0.2.36",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@types/jest": "^29.5.12",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/webpack-env": "^1.18.8",
    "dayjs": "1.x",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "openmrs": "10.0.0",
    "react": "18.x",
    "react-dom": "18.x",
    "react-i18next": "^11.18.6",
    "react-router-dom": "^6.22.0",
    "rxjs": "6.x",
    "typescript": "^5.6.0"
  }
}
