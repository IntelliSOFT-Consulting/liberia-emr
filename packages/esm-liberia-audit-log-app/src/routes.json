{
  "$schema": "https://json.openmrs.org/routes.schema.json",
  "backendDependencies": {
    "webservices.rest": ">=2.47.0"
  },
  "pages": [
    {
      "component": "root",
      "route": "audit-log"
    }
  ],
  "extensions": [
    {
      "name": "audit-log-app-menu-item",
      "component": "auditLogAppMenuItem",
      "slot": "app-menu-slot",
      "privileges": ["View Audit Log"],
      "online": true,
      "offline": false
    },
    {
      "name": "audit-log-dashboard-link",
      "component": "auditLogDashboardLink",
      "slot": "homepage-dashboard-slot",
      "privileges": ["View Audit Log"],
      "meta": {
        "name": "audit-log",
        "slot": "audit-log-dashboard-slot",
        "title": "Audit log"
      },
      "online": true,
      "offline": false
    },
    {
      "name": "audit-log-dashboard",
      "component": "root",
      "slot": "audit-log-dashboard-slot",
      "privileges": ["View Audit Log"],
      "online": true,
      "offline": false
    }
  ]
}
