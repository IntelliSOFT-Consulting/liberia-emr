{
  "name": "@liberiaemr/esm-liberia-patient-chart-extension",
  "version": "1.0.0-SNAPSHOT",
  "license": "MPL-2.0",
  "description": "Generic configurable obs-by-encounter widget for LiberiaEMR patient chart",
  "browser": "dist/liberiaemr-esm-liberia-patient-chart-extension.js",
  "main": "src/index.ts",
  "source": true,
  "scripts": {
    "start": "openmrs develop --backend https://liberiaemrfacilitydev.intellisoftkenya.com",
    "start:local": "openmrs develop --backend http://localhost:8085 --port 8082 --config-file ../../distribution/frontend/config/config-national.json",
    "serve": "rspack serve --mode=development",
    "build": "rspack --mode=production",
    "analyze": "rspack --mode=production --env analyze=true",
    "lint": "eslint src --ext ts,tsx",
    "typescript": "tsc",
    "test": "echo 'No tests specified'",
    "verify": "turbo lint typescript",
    "extract-translations": "i18next 'src/**/*.component.tsx'"
  },
  "browserslist": [
    "extends browserslist-config-openmrs"
  ],
  "keywords": [
    "openmrs",
    "microfrontends",
    "liberia",
    "patient-chart"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IntelliSOFT-Consulting/liberia-emr.git"
  },
  "peerDependencies": {
    "@openmrs/esm-framework": "*",
    "@openmrs/esm-patient-common-lib": "*",
    "dayjs": "1.x",
    "react": "18.x",
    "react-i18next": "11.x",
    "react-router-dom": "6.x",
    "rxjs": "6.x",
    "swr": "2.x"
  },
  "dependencies": {
    "@carbon/charts": "^1.27.18",
    "@carbon/charts-react": "^1.27.18",
    "@carbon/react": "^1.71.0",
    "classnames": "^2.3.2",
    "d3": "^7.9.0",
    "lodash-es": "^4.17.21"
  },
  "devDependencies": {
    "@openmrs/esm-framework": "next",
    "@openmrs/esm-patient-chart-app": "next",
    "@openmrs/esm-patient-common-lib": "next",
    "@types/fhir": "^0.0.31",
    "@types/lodash-es": "^4.17.9",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/webpack-env": "^1.18.4",
    "dayjs": "1.x",
    "openmrs": "next",
    "react": "18.x",
    "react-aria": "3.x",
    "react-dom": "18.x",
    "react-i18next": "11.x",
    "react-is": "*",
    "react-router-dom": "6.x",
    "react-stately": "3.x",
    "rxjs": "6.x",
    "sass": "*",
    "single-spa": "*",
    "single-spa-react": "6.x",
    "swr": "2.x",
    "typescript": "^5.6.0",
    "uuid": "9.x",
    "zustand": "4.x"
  }
}
