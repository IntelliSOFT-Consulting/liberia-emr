{
  "name": "@liberiaemr/esm-liberia-epartograph-app",
  "version": "1.0.0",
  "license": "MPL-2.0",
  "description": "WHO-aligned electronic partograph for LiberiaEMR",
  "browser": "dist/liberiaemr-esm-liberia-epartograph-app.js",
  "main": "src/index.ts",
  "source": true,
  "scripts": {
    "start": "openmrs develop",
    "start:dev": "openmrs develop --backend https://liberiaemrfacilitydev.intellisoftkenya.com --config-file ../../distribution/frontend/config/config-national.json --config-file ../../distribution/frontend/config/config-mch.json",
    "start:local": "openmrs develop --backend http://localhost:8085 --port 8083 --config-file ../../distribution/frontend/config/config-national.json --config-file ../../distribution/frontend/config/config-mch.json",
    "serve": "rspack serve --mode=development",
    "build": "rspack --mode production",
    "analyze": "rspack --mode=production --env analyze=true",
    "lint": "eslint src --ext ts,tsx",
    "typescript": "tsc",
    "test": "jest --config jest.config.js",
    "verify": "turbo lint typescript test",
    "extract-translations": "i18next 'src/**/*.component.tsx'"
  },
  "browserslist": [
    "extends browserslist-config-openmrs"
  ],
  "keywords": [
    "openmrs",
    "microfrontends",
    "liberia",
    "partograph",
    "maternal health"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IntelliSOFT-Consulting/liberia-emr.git"
  },
  "peerDependencies": {
    "@openmrs/esm-framework": "*",
    "dayjs": "1.x",
    "react": "18.x",
    "react-i18next": "11.x",
    "react-router-dom": "6.x",
    "rxjs": "6.x"
  },
  "dependencies": {
    "@carbon/charts": "^1.15.0",
    "@carbon/charts-react": "^1.15.0",
    "@carbon/react": "^1.71.0",
    "@openmrs/esm-patient-common-lib": "next",
    "lodash-es": "^4.17.21",
    "swr": "^2.2.5"
  },
  "devDependencies": {
    "@openmrs/esm-framework": "^10.0.1-pre.5227",
    "@rspack/cli": "^1.0.0",
    "@rspack/core": "^1.0.0",
    "@types/fhir": "^0.0.44",
    "@types/lodash-es": "^4.17.12",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/webpack-env": "^1.18.8",
    "openmrs": "^10.0.1-pre.5227",
    "typescript": "^5.6.0"
  }
}
