{
  "name": "@liberiaemr/esm-liberia-epartograph-app",
  "version": "1.0.0-SNAPSHOT",
  "license": "MPL-2.0",
  "description": "WHO-aligned electronic partograph for LiberiaEMR",
  "browser": "dist/liberiaemr-esm-liberia-epartograph-app.js",
  "main": "src/index.ts",
  "source": true,
  "scripts": {
    "start": "openmrs develop",
    "serve": "webpack serve --mode=development",
    "build": "webpack --mode production",
    "analyze": "webpack --mode=production --env analyze=true",
    "lint": "eslint src --ext ts,tsx",
    "typescript": "tsc",
    "test": "jest --config jest.config.js",
    "verify": "turbo lint typescript test",
    "extract-translations": "i18next 'src/**/*.component.tsx'"
  },
  "browserslist": [
    "extends browserslist-config-openmrs"
  ],
  "keywords": [
    "openmrs",
    "microfrontends",
    "liberia",
    "partograph",
    "maternal health"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IntelliSOFT-Consulting/liberia-emr.git"
  },
  "peerDependencies": {
    "@openmrs/esm-framework": "*",
    "dayjs": "1.x",
    "react": "18.x",
    "react-i18next": "11.x",
    "react-router-dom": "6.x",
    "rxjs": "6.x"
  },
  "dependencies": {
    "@carbon/react": "^1.71.0",
    "lodash-es": "^4.17.21"
  },
  "devDependencies": {
    "@openmrs/esm-framework": "next",
    "@openmrs/webpack-config": "next",
    "openmrs": "next",
    "typescript": "^5.6.0",
    "webpack": "^5.95.0"
  }
}
