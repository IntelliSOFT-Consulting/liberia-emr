# LiberiaEMR DEMO/TRAINING environment — TEMPLATE ONLY.
#
# Copy to demo.env and fill in. demo.env is git-ignored and MUST NOT be committed.
#   cp demo.env.example demo.env
#
# TRAINING AND TEST ONLY. A stack started with this file runs the -demo images, which carry
# content-demo (the reference application demo metadata, lifted from upstream). It must
# never run on facility production hardware, never share a database with a production
# instance, and never hold a real patient record. See docs/runbooks/demo-stack.md.

# --- Release ---------------------------------------------------------------
REGISTRY=ghcr.io/intellisoft-consulting
# The -demo image tag, built by: scripts/build/build-distribution.sh --version <x.y.z> --demo
# Not -SNAPSHOT: build-distribution.sh refuses to build an image at a snapshot version.
LIBERIAEMR_VERSION=1.0.0

# --- Site identity ---------------------------------------------------------
# Which site content package was baked into the image being trained on. Match the --site
# the image was built with, or the training room practises on the wrong facility.
FACILITY_CODE=careysburg

# --- Database --------------------------------------------------------------
# A throwaway database that is wiped between training sessions. Use passwords that are
# obviously not production's — sharing a real credential with a training box is how a
# training box becomes a way into production.
MYSQL_DATABASE=openmrs
MYSQL_USER=openmrs
MYSQL_PASSWORD=demo-not-a-secret
MYSQL_ROOT_PASSWORD=demo-not-a-secret-root

# true for the FIRST boot on an empty database, then back to false. A demo stack is reset
# often (docker compose down -v), so expect to set this true again after every reset.
OMRS_CREATE_TABLES=true

# --- Resources -------------------------------------------------------------
# A training laptop is usually smaller than a facility server.
BACKEND_HEAP=2g

# --- TLS -------------------------------------------------------------------
# The gateway terminates TLS and will not start without fullchain.pem and privkey.pem in
# this directory. A self-signed pair is fine for training; see the runbook.
TLS_CERT_DIR=/etc/liberiaemr/demo-certs

# --- Sync to central -------------------------------------------------------
# DELIBERATELY EMPTY. The demo overlay disables the sync service three ways over, and
# this value is the fourth: with no broker URL the sender refuses to start, so fabricated
# patients can never reach central. Do not paste the central broker address here "just to
# test the link"; deploy-facility.sh --demo refuses an env file that names it.
ARTEMIS_URL=

# --- Legacy admin UI -------------------------------------------------------
# MOH ICT SOP control D5: the legacy OpenMRS admin UI is disabled in production. It is
# blocked at the gateway AND switched off in the backend, both from this one variable.
#
# Leave it unset (or false) for any facility or central instance. Set it to true ONLY on
# a dev, staging or local box, where Manage Modules and the legacy scheduler are still
# needed because O3 has no equivalent yet:
#
#   LEGACY_ADMIN_UI=true
#
# Only true and false are valid. Anything else names a gateway snippet that does not
# exist and nginx will refuse to start, on purpose — a typo must not read as "allowed".
