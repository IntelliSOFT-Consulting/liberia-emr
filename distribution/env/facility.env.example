# LiberiaEMR facility environment — TEMPLATE ONLY.
#
# Copy to facility.env and fill in per site. facility.env is git-ignored and MUST NOT be
# committed. Real secrets live in the MOH secret store, not in this repository.
#   cp facility.env.example facility.env

# --- Release ---------------------------------------------------------------
REGISTRY=ghcr.io/intellisoft-consulting
LIBERIAEMR_VERSION=1.0.0
# This site's release images (LE-360): a release publishes the backend and frontend per site,
# e.g. liberia-emr-backend-careysburg:1.0.0, so set it to this facility's site package name.
# Left empty, compose uses the unsuffixed names, which only CI and development builds publish
# (the dev server's :latest); a release has no such image.
LIBERIAEMR_SITE=careysburg

# --- Site identity ---------------------------------------------------------
# careysburg | barnersville — this facility's code. The site content package baked into the
# image is chosen by LIBERIAEMR_SITE above; the two normally hold the same value.
FACILITY_CODE=careysburg

# --- Database --------------------------------------------------------------
MYSQL_DATABASE=openmrs
MYSQL_USER=openmrs
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME

# Set to true for the FIRST boot on an empty database only, then set back to false.
OMRS_CREATE_TABLES=false

# --- Reporting ETL (mamba-etl-liberiaemr) ----------------------------------
# The database account that builds the local reporting schema, liberiaemr_etl, from this
# database (ADR 0010). Created with its grants on the database's FIRST boot when the password
# is set (initdb/20-etl-db-user.sh); on an existing database run that script's statements by
# hand. Unset, the module logs that it could not deploy and no report has data. It never
# falls back to MYSQL_USER. The password lands in openmrs-runtime.properties, beside
# connection.password.
ETL_DB_USER=mambaetl
ETL_DB_PASSWORD=CHANGE_ME
# Seconds between ETL runs; must exceed one incremental run. Provisional.
ETL_INTERVAL_SECONDS=1800

# --- Resources -------------------------------------------------------------
BACKEND_HEAP=3g

# --- TLS -------------------------------------------------------------------
# Host directory holding fullchain.pem and privkey.pem. Certificates are mounted, never
# baked into an image and never committed.
TLS_CERT_DIR=/etc/liberiaemr/certs

# --- Sync to central -------------------------------------------------------
# The sync service only starts under `--profile sync`. Everything below feeds the dbsync
# sender (distribution/sync/). If this facility may ever sync, set DEBEZIUM_DB_PASSWORD and
# SYNC_MGMT_DB_PASSWORD before the database's first boot: their accounts are created then only.

# The broker at central: ssl://<central-host>:61617, where the host is one of the names
# in the broker certificate. The sender refuses plain tcp and any URL options.
ARTEMIS_URL=

# What the sender does on its first start, and again if its saved position is lost: initial
# sends every record already in this database, schema_only sends only changes from then on.
# schema_only defers, it does not exclude: a training record edited later is sent like any
# other. Records that must never reach central have to be removed from the database before
# the facility is enrolled.
SYNC_SNAPSHOT_MODE=initial
# Nightly reconciliation (sync-eip.md 5.5) compares every record with central. A facility
# enrolled with schema_only sets when it was enrolled here (YYYY-MM-DD, or YYYY-MM-DDTHH:MM in
# UTC), so the records it deliberately never sent are not reported missing.
SYNC_RECON_SINCE=

# This facility's client certificate and PGP keys (layout in
# scripts/security/gen-sync-certs.sh); issued by the MOH ICT Unit in production.
SYNC_CERTS_DIR=/etc/liberiaemr/sync-certs

# Debezium's replication-privileged database account (created on first boot when the
# password is set). DEBEZIUM_SERVER_ID must be unique on this database server and
# distinct from DB_SERVER_ID below; neither may change once the sender has run.
DEBEZIUM_DB_USER=debezium
DEBEZIUM_DB_PASSWORD=
DEBEZIUM_SERVER_ID=20001

# The sender's management schema on the facility database server.
SYNC_MGMT_DB_NAME=openmrs_mgmt
SYNC_MGMT_DB_USER=dbsync_mgmt
SYNC_MGMT_DB_PASSWORD=

# REST account the sender uses against the local backend (platform version at start-up,
# complex-obs payloads). A dedicated account with the Sync Sender role only, not admin
# (docs/runbooks/sync-operations.md section 6).
SYNC_REST_USER=
SYNC_REST_PASSWORD=

# Binary log identity and retention (sync-eip.md section 1.3). MariaDB caps retention
# at 8553600 seconds (99 days); that cap is the default and the ceiling, and the gap to
# the doc's six-month ambition is risk F1's problem. Size the disk for it.
DB_SERVER_ID=1
BINLOG_EXPIRE_SECONDS=8553600

# --- Monitoring (rides the sync profile) -----------------------------------
# Where alerts are delivered: email through an SMTP relay, a webhook (Slack, Teams, an
# SMS gateway), or both. With neither, alerts are visible only in the Prometheus and
# Alertmanager UIs, acceptable on a dev box only. UIs bind loopback unless PROM_BIND_ADDR
# is set consciously. ALERT_SMTP_REQUIRE_TLS=false only for a relay on a trusted network.
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
ALERT_SMTP_SMARTHOST=
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_WEBHOOK_URL=
PROM_BIND_ADDR=127.0.0.1

# --- Password reset email (liberiaemr module) ------------------------------
# The relay the backend sends password reset links through. Unset means no reset mail is
# delivered at all, which is a supported state for a dev box and never for a facility.
#
# The password is a CREDENTIAL and is deliberately not a global property: an Initializer
# file would put it in git AND reapply itself over the real value on every restart. Prefer
# LIBERIAEMR_SMTP_PASSWORD_FILE, a path read verbatim (same shape as ALERT_WEBHOOK_URL's
# url_file), so no character in the secret is interpreted by a substitution tool; mount it
# with `secrets:` or a read-only bind. LIBERIAEMR_SMTP_PASSWORD is the simpler fallback.
#
# LIBERIAEMR_FRONTEND_URL must carry NO trailing slash and must be the address a user's
# browser can reach — it is what the emailed reset link is built from.
LIBERIAEMR_SMTP_HOST=
LIBERIAEMR_SMTP_PORT=587
LIBERIAEMR_SMTP_USER=
LIBERIAEMR_SMTP_PASSWORD=
LIBERIAEMR_SMTP_PASSWORD_FILE=
LIBERIAEMR_SMTP_FROM=
LIBERIAEMR_FRONTEND_URL=

# The MOH Master Facility List sync (ADR 0009) runs at central. A facility leaves these
# empty, so the sync is unavailable here; set them only if this facility needs every other
# facility as a location. See distribution/env/central.env.example.
LIBERIAEMR_MFL_USERNAME=
LIBERIAEMR_MFL_PASSWORD=
# Preferred: put the password in a host file (mode 0400, owned by uid 1001), name it in
# LIBERIAEMR_MFL_PASSWORD_HOST_FILE, and set LIBERIAEMR_MFL_PASSWORD_FILE to the path the
# compose file mounts it at, /run/secrets/mfl-password.
LIBERIAEMR_MFL_PASSWORD_HOST_FILE=
LIBERIAEMR_MFL_PASSWORD_FILE=
LIBERIAEMR_MFL_ALLOWED_HOSTS=dhis2.moh.gov.lr

# --- Legacy admin UI -------------------------------------------------------
# MOH ICT SOP control D5: the legacy OpenMRS admin UI is disabled in production. It is
# blocked at the gateway AND switched off in the backend, both from this one variable.
#
# Leave it unset (or false) for any facility or central instance. Set it to true ONLY on
# a dev, staging or local box, where Manage Modules and the legacy scheduler are still
# needed because O3 has no equivalent yet:
#
#   LEGACY_ADMIN_UI=true
#
# Only true and false are valid. Anything else names a gateway snippet that does not
# exist and nginx will refuse to start, on purpose — a typo must not read as "allowed".
