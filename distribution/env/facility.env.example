# LiberiaEMR facility environment — TEMPLATE ONLY.
#
# Copy to facility.env and fill in per site. facility.env is git-ignored and MUST NOT be
# committed. Real secrets live in the MOH secret store, not in this repository.
#   cp facility.env.example facility.env

# --- Release ---------------------------------------------------------------
REGISTRY=ghcr.io/intellisoft-consulting
LIBERIAEMR_VERSION=1.0.0

# --- Site identity ---------------------------------------------------------
# careysburg | barnersville — selects the site content package baked into the image.
FACILITY_CODE=careysburg

# --- Database --------------------------------------------------------------
MYSQL_DATABASE=openmrs
MYSQL_USER=openmrs
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME

# Set to true for the FIRST boot on an empty database only, then set back to false.
OMRS_CREATE_TABLES=false

# --- Resources -------------------------------------------------------------
BACKEND_HEAP=3g

# --- TLS -------------------------------------------------------------------
# Host directory holding fullchain.pem and privkey.pem. Certificates are mounted, never
# baked into an image and never committed.
TLS_CERT_DIR=/etc/liberiaemr/certs

# --- Sync to central -------------------------------------------------------
CENTRAL_URL=https://central.moh.gov.lr

# --- Legacy admin UI -------------------------------------------------------
# MOH ICT SOP control D5: the legacy OpenMRS admin UI is disabled in production. It is
# blocked at the gateway AND switched off in the backend, both from this one variable.
#
# Leave it unset (or false) for any facility or central instance. Set it to true ONLY on
# a dev, staging or local box, where Manage Modules and the legacy scheduler are still
# needed because O3 has no equivalent yet:
#
#   LEGACY_ADMIN_UI=true
#
# Only true and false are valid. Anything else names a gateway snippet that does not
# exist and nginx will refuse to start, on purpose — a typo must not read as "allowed".
