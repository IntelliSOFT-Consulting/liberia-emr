# LiberiaEMR facility environment — TEMPLATE ONLY.
#
# Copy to facility.env and fill in per site. facility.env is git-ignored and MUST NOT be
# committed. Real secrets live in the MOH secret store, not in this repository.
#   cp facility.env.example facility.env

# --- Release ---------------------------------------------------------------
REGISTRY=ghcr.io/intellisoft-consulting
LIBERIAEMR_VERSION=1.0.0

# --- Site identity ---------------------------------------------------------
# careysburg | barnersville — selects the site content package baked into the image.
FACILITY_CODE=careysburg

# --- Database --------------------------------------------------------------
MYSQL_DATABASE=openmrs
MYSQL_USER=openmrs
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME

# Set to true for the FIRST boot on an empty database only, then set back to false.
OMRS_CREATE_TABLES=false

# --- Resources -------------------------------------------------------------
BACKEND_HEAP=3g

# --- TLS -------------------------------------------------------------------
# Host directory holding fullchain.pem and privkey.pem. Certificates are mounted, never
# baked into an image and never committed.
TLS_CERT_DIR=/etc/liberiaemr/certs

# --- Sync to central -------------------------------------------------------
# The sync service only starts under `--profile sync`. Everything below feeds the dbsync
# sender (distribution/sync/); leave the passwords empty on a stack that never runs it.

# The broker at central: ssl://<central-host>:61617, where the host is one of the names
# in the broker certificate. The sender refuses plain tcp and any URL options.
ARTEMIS_URL=

# This facility's client certificate and PGP keys (layout in
# scripts/security/gen-sync-certs.sh); issued by the MOH ICT Unit in production.
SYNC_CERTS_DIR=/etc/liberiaemr/sync-certs

# Debezium's replication-privileged database account (created on first boot when the
# password is set). DEBEZIUM_SERVER_ID must be unique on this database server and
# distinct from DB_SERVER_ID below; neither may change once the sender has run.
DEBEZIUM_DB_USER=debezium
DEBEZIUM_DB_PASSWORD=
DEBEZIUM_SERVER_ID=20001

# The sender's management schema on the facility database server.
SYNC_MGMT_DB_NAME=openmrs_mgmt
SYNC_MGMT_DB_USER=dbsync_mgmt
SYNC_MGMT_DB_PASSWORD=

# REST account the sender uses against the local backend (platform version at start-up,
# complex-obs payloads). A dedicated account with the Sync Sender role only, not admin
# (docs/runbooks/sync-operations.md section 6).
SYNC_REST_USER=
SYNC_REST_PASSWORD=

# Binary log identity and retention (sync-eip.md section 1.3). MariaDB caps retention
# at 8553600 seconds (99 days); that cap is the default and the ceiling, and the gap to
# the doc's six-month ambition is risk F1's problem. Size the disk for it.
DB_SERVER_ID=1
BINLOG_EXPIRE_SECONDS=8553600

# --- Monitoring (rides the sync profile) -----------------------------------
# Where alerts are delivered: email through an SMTP relay, a webhook (Slack, Teams, an
# SMS gateway), or both. With neither, alerts are visible only in the Prometheus and
# Alertmanager UIs, acceptable on a dev box only. UIs bind loopback unless PROM_BIND_ADDR
# is set consciously. ALERT_SMTP_REQUIRE_TLS=false only for a relay on a trusted network.
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
ALERT_SMTP_SMARTHOST=
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_WEBHOOK_URL=
PROM_BIND_ADDR=127.0.0.1

# --- Legacy admin UI -------------------------------------------------------
# MOH ICT SOP control D5: the legacy OpenMRS admin UI is disabled in production. It is
# blocked at the gateway AND switched off in the backend, both from this one variable.
#
# Leave it unset (or false) for any facility or central instance. Set it to true ONLY on
# a dev, staging or local box, where Manage Modules and the legacy scheduler are still
# needed because O3 has no equivalent yet:
#
#   LEGACY_ADMIN_UI=true
#
# Only true and false are valid. Anything else names a gateway snippet that does not
# exist and nginx will refuse to start, on purpose — a typo must not read as "allowed".
