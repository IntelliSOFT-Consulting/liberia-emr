# LiberiaEMR central environment — TEMPLATE ONLY.
#
# Copy to central.env and fill in. central.env is git-ignored and MUST NOT be committed.

# --- Release ---------------------------------------------------------------
REGISTRY=ghcr.io/intellisoft-consulting
LIBERIAEMR_VERSION=1.0.0

# --- Database --------------------------------------------------------------
MYSQL_DATABASE=openmrs
MYSQL_USER=openmrs
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME

# Set to true for the FIRST boot on an empty database only, then set back to false.
OMRS_CREATE_TABLES=false

# --- Resources -------------------------------------------------------------
BACKEND_HEAP=6g

# --- TLS -------------------------------------------------------------------
TLS_CERT_DIR=/etc/liberiaemr/certs

# --- Sync: broker and receiver ---------------------------------------------
# The broker facilities push to, over mutual TLS, and the receiver that applies pushes
# to the central database. There are no broker passwords: every client presents a
# certificate. Security material is mounted from these directories (layout in
# scripts/security/gen-sync-certs.sh); in production the MOH ICT Unit issues it.
BROKER_CERTS_DIR=/etc/liberiaemr/broker-certs
RECEIVER_CERTS_DIR=/etc/liberiaemr/receiver-certs

# The host interface the broker port binds to. Set this to the MOH-facing interface IP
# on any deployed central; 0.0.0.0 is for single-host development only.
ARTEMIS_BIND_ADDR=CHANGE_ME

# The receiver's management schema on the central database server. Created on first
# boot by initdb/10-sync-mgmt-db.sh when the password is set.
SYNC_MGMT_DB_NAME=openmrs_mgmt
SYNC_MGMT_DB_USER=dbsync_mgmt
SYNC_MGMT_DB_PASSWORD=CHANGE_ME

# When the receiver applies decisions from the Sync conflicts page, HH:MM-HH:MM UTC. Pick a
# quiet time: the receiver stops while it applies them. Empty leaves scripts/sync/conflicts.sh.
SYNC_CONFLICT_WINDOW=01:00-05:00

# REST account the receiver uses against the central backend (platform version at
# start-up, search index updates). A dedicated account with the Sync Receiver role only,
# not admin (docs/runbooks/sync-operations.md section 6).
SYNC_REST_USER=CHANGE_ME
SYNC_REST_PASSWORD=CHANGE_ME

# --- DHIS2 (blocked on MOH data-element mappings) --------------------------
DHIS2_BASE_URL=https://dhis2.moh.gov.lr
DHIS2_USERNAME=CHANGE_ME
DHIS2_PASSWORD=CHANGE_ME

# --- Monitoring (rides the sync profile) -----------------------------------
# Where alerts are delivered: email through an SMTP relay, a webhook (Slack, Teams, an
# SMS gateway), or both. With neither, alerts are visible only in the Prometheus and
# Alertmanager UIs, acceptable on a dev box only. UIs bind loopback unless PROM_BIND_ADDR
# is set consciously. ALERT_SMTP_REQUIRE_TLS=false only for a relay on a trusted network.
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
ALERT_SMTP_SMARTHOST=
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_WEBHOOK_URL=
PROM_BIND_ADDR=127.0.0.1

# Where the sync status page reads its numbers, which is this stack's own Prometheus. Leave
# the default unless monitoring runs elsewhere; empty turns the page off, and staff see
# nothing about how facilities are syncing.
LIBERIAEMR_SYNC_MONITORING_URL=http://prometheus:9090

# --- Password reset email (liberiaemr module) ------------------------------
# The relay the backend sends password reset links through. Unset means no reset mail is
# delivered at all, which is a supported state for a dev box and never for a facility.
#
# The password is a CREDENTIAL and is deliberately not a global property: an Initializer
# file would put it in git AND reapply itself over the real value on every restart. Prefer
# LIBERIAEMR_SMTP_PASSWORD_FILE, a path read verbatim (same shape as ALERT_WEBHOOK_URL's
# url_file), so no character in the secret is interpreted by a substitution tool; mount it
# with `secrets:` or a read-only bind. LIBERIAEMR_SMTP_PASSWORD is the simpler fallback.
#
# LIBERIAEMR_FRONTEND_URL must carry NO trailing slash and must be the address a user's
# browser can reach — it is what the emailed reset link is built from.
LIBERIAEMR_SMTP_HOST=
LIBERIAEMR_SMTP_PORT=587
LIBERIAEMR_SMTP_USER=
LIBERIAEMR_SMTP_PASSWORD=
LIBERIAEMR_SMTP_PASSWORD_FILE=
LIBERIAEMR_SMTP_FROM=
LIBERIAEMR_FRONTEND_URL=
