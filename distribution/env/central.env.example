# LiberiaEMR central environment — TEMPLATE ONLY.
#
# Copy to central.env and fill in. central.env is git-ignored and MUST NOT be committed.

# --- Release ---------------------------------------------------------------
REGISTRY=ghcr.io/intellisoft-consulting
LIBERIAEMR_VERSION=1.0.0

# --- Database --------------------------------------------------------------
MYSQL_DATABASE=openmrs
MYSQL_USER=openmrs
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME

# --- Resources -------------------------------------------------------------
BACKEND_HEAP=6g

# --- TLS -------------------------------------------------------------------
TLS_CERT_DIR=/etc/liberiaemr/certs

# --- Sync receiver ---------------------------------------------------------
# Comma-separated facility codes permitted to push. Anything else is rejected.
ALLOWED_FACILITY_CODES=careysburg,barnersville

# --- DHIS2 (blocked on MOH data-element mappings) --------------------------
DHIS2_BASE_URL=https://dhis2.moh.gov.lr
DHIS2_USERNAME=CHANGE_ME
DHIS2_PASSWORD=CHANGE_ME
