# LiberiaEMR central environment — TEMPLATE ONLY.
#
# Copy to central.env and fill in. central.env is git-ignored and MUST NOT be committed.

# --- Release ---------------------------------------------------------------
REGISTRY=ghcr.io/intellisoft-consulting
LIBERIAEMR_VERSION=1.0.0

# --- Database --------------------------------------------------------------
MYSQL_DATABASE=openmrs
MYSQL_USER=openmrs
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME

# Set to true for the FIRST boot on an empty database only, then set back to false.
OMRS_CREATE_TABLES=false

# --- Resources -------------------------------------------------------------
BACKEND_HEAP=6g

# --- TLS -------------------------------------------------------------------
TLS_CERT_DIR=/etc/liberiaemr/certs

# --- Sync: broker and receiver ---------------------------------------------
# The Artemis broker facilities push to, and the receiver that applies pushes to the
# central database. The broker credentials here are the INTERIM shared secret; the
# hardening build replaces them with per-facility client certificates (controls
# D2/D6/D8), and until it lands the broker port must not be reachable from outside the
# MOH network. Who may push is decided at the broker, not by an application-level
# facility list.
ARTEMIS_USER=CHANGE_ME
ARTEMIS_PASSWORD=CHANGE_ME

# The host interface the broker port binds to. Set this to the MOH-facing interface IP
# on any deployed central; 0.0.0.0 is for single-host development only.
ARTEMIS_BIND_ADDR=CHANGE_ME

# The receiver's management schema on the central database server. Created on first
# boot by initdb/10-sync-mgmt-db.sh when the password is set.
SYNC_MGMT_DB_NAME=openmrs_mgmt
SYNC_MGMT_DB_USER=dbsync_mgmt
SYNC_MGMT_DB_PASSWORD=CHANGE_ME

# REST account the receiver uses against the central backend (platform version at
# start-up, search index updates). A dedicated, least-privilege account, not admin.
SYNC_REST_USER=CHANGE_ME
SYNC_REST_PASSWORD=CHANGE_ME

# --- DHIS2 (blocked on MOH data-element mappings) --------------------------
DHIS2_BASE_URL=https://dhis2.moh.gov.lr
DHIS2_USERNAME=CHANGE_ME
DHIS2_PASSWORD=CHANGE_ME

# --- Monitoring (rides the sync profile) -----------------------------------
# Where alerts are delivered: any webhook (Slack, Teams, an SMS gateway). Unset means
# alerts are visible only in the Prometheus/Alertmanager UIs, acceptable on a dev box
# only. UIs bind loopback unless PROM_BIND_ADDR is set consciously.
ALERT_WEBHOOK_URL=
PROM_BIND_ADDR=127.0.0.1
