# dbsync receiver configuration, rendered by docker-entrypoint-receiver.sh from the
# environment. ${VAR} placeholders are substituted with envsubst; everything else is
# literal and follows the upstream template (receiver-app/configuration/
# application.properties in mekomsolutions/openmrs-dbsync at the pinned tag).

eip.home=/opt/eip
spring.jpa.open-in-view=false

# Records every install creates with the same uuid, which central holds without a sync hash:
# the admin user, its person and name (OpenMRS core), the Unknown provider (core) and the admin
# provider (content-liberia-national liquibase/admin-provider.xml). dbsync refuses such a
# record from a facility and retries it forever, so they are skipped; the daemon user already
# is. Table names are dbsync's own (users, not user). Anything else excluded here would be
# dropped silently, so the entity set is decided at the sender (sync-entity-coverage.md).
db-sync.excludedEntities=users:82f18b44-6814-11e8-923f-e9a88dcb533f,person:5f87c042-6814-11e8-923f-e9a88dcb533f,person_name:5f897a68-6814-11e8-923f-e9a88dcb533f,provider:f9badd80-ab76-11e2-9e96-0800200c9a66,provider:55bc2590-ceb2-4832-8148-d163fbdebee3

inbound.retry.interval=1800000
inbound.retry.initial.delay=120000

# true is a MAINTENANCE mode that halts all sync and batch-recomputes hashes, then exits;
# run it as a one-off container (docs/runbooks/sync-operations.md). Normal per-message
# hash storage happens regardless of this flag.
hashes.update=${SYNC_HASHES_UPDATE}
hashes.update.tables=${SYNC_HASHES_UPDATE_TABLES}

# Log to the console; the container runtime owns log collection. NO PHI in logs
# (integration/eip/routes/README.md).
logging.config=classpath:logback-console.xml
openmrs.eip.log.level=${LOG_LEVEL}
logging.level.oauth2-token-route=${LOG_LEVEL}
logging.level.receiver=${LOG_LEVEL}
logging.level.receiver-db-sync=${LOG_LEVEL}
logging.level.receiver-complex-obs-sync=${LOG_LEVEL}
logging.level.receiver-error-handler=${LOG_LEVEL}
# WARN, not LOG_LEVEL: at INFO these log clinical content, the retry route each retried
# message's payload and ComplexObsProcessor a complex obs file whose hash changed.
logging.level.receiver-retry=WARN
logging.level.org.openmrs.eip.dbsync.receiver.ComplexObsProcessor=WARN
logging.level.receiver-update-search-index=${LOG_LEVEL}
logging.level.receiver-clear-db-cache=${LOG_LEVEL}
logging.level.org.openmrs.eip=${LOG_LEVEL}

# Health and Prometheus metrics for the alerting build (LE-35 acceptance criterion 3).
management.endpoints.enabled-by-default=false
management.endpoint.prometheus.enabled=true
management.endpoint.health.enabled=true
management.endpoints.web.exposure.include=health,prometheus

# REST access to the central OpenMRS instance: platform version at start-up, search
# index updates, complex-obs writes.
openmrs.baseUrl=${OPENMRS_BASE_URL}
openmrs.username=${OPENMRS_REST_USER}
openmrs.password=${OPENMRS_REST_PASSWORD}

openmrs.db.host=${OPENMRS_DB_HOST}
openmrs.db.port=${OPENMRS_DB_PORT}
openmrs.db.name=${OPENMRS_DB_NAME}

spring.openmrs-datasource.driverClassName=com.mysql.cj.jdbc.Driver
spring.openmrs-datasource.jdbcUrl=jdbc:mysql://${OPENMRS_DB_HOST}:${OPENMRS_DB_PORT}/${OPENMRS_DB_NAME}
spring.openmrs-datasource.username=${OPENMRS_DB_USER}
spring.openmrs-datasource.password=${OPENMRS_DB_PASSWORD}

# The management database holds the receiver's durable state: inbound queues, the
# conflict queue, retry queues, and the per-entity hashes. Its principal is created on
# the first boot of the central database by distribution/compose/central/initdb/.
spring.mngt-datasource.driverClassName=com.mysql.cj.jdbc.Driver
spring.mngt-datasource.jdbcUrl=jdbc:mysql://${OPENMRS_DB_HOST}:${OPENMRS_DB_PORT}/${MGMT_DB_NAME}
spring.mngt-datasource.username=${MGMT_DB_USER}
spring.mngt-datasource.password=${MGMT_DB_PASSWORD}

# The broker, over mutual TLS with the receiver's client certificate (JVM properties set
# by the entrypoint); no username or password.
spring.artemis.brokerUrl=${ARTEMIS_URL}

# The broker declares this subscription's queue (DB-SYNC-REC.DB-SYNC-RECEIVER), so a
# change here must be matched in scripts/security/render-broker-config.sh.
# acknowledgementMode=4 is ActiveMQ's INDIVIDUAL_ACKNOWLEDGE. Upstream's CLIENT_ACKNOWLEDGE
# acknowledges every earlier message in the session, so a message that failed was dropped
# when the next one succeeded during the receiver's shutdown, instead of being redelivered
# and, after 10 attempts, dead-lettered. qa/sync/verify-receiver-failure.sh proves it.
# disableReplyTo: dbsync never replies, and JMSReplyTo is set by the sender.
camel.input.endpoint=activemq:topic:openmrs.sync.topic?subscriptionDurable=true&durableSubscriptionName=DB-SYNC-RECEIVER&connectionFactory=activeMqConnFactory&acknowledgementMode=4&disableReplyTo=true&messageListenerContainerFactory=customMessageListenerContainerFactory
activemq.clientId=DB-SYNC-REC

openmrs.complex.obs.data.directory=${COMPLEX_OBS_DIR}

# PGP: every message is decrypted with the receiver's key and must carry a valid
# signature from the facility key it names; pgp/ holds every enrolled facility's public key.
openmrs.eip.dbsync.encryption.enabled=true
# dbsync reads this relative to its working directory, /app.
pgp.receiver.keysFolderPath=/sync-certs/pgp
pgp.receiver.password=${PGP_PASSWORD}

# Disabled, but the oauth Camel route resolves these placeholders at start-up even so;
# the keys must exist with empty values or the application fails to boot.
oauth.enabled=false
oauth.access.token.uri=
oauth.client.id=
oauth.client.secret=
oauth.client.scope=
