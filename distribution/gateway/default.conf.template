# LiberiaEMR gateway — TLS termination and routing.
#
# This is an nginx TEMPLATE, not a ready config: the official entrypoint runs envsubst
# over /etc/nginx/templates/*.template into /etc/nginx/conf.d/ at container start. Only
# names matching NGINX_ENVSUBST_FILTER (^LEGACY_ADMIN_) are substituted, so nginx's own
# $host / $uri / $request_uri survive untouched. Do not COPY this straight into conf.d.
#
# TLS is contractual for facility<->cloud traffic (MOH ICT SOPs Feb 2023 v1.1.0,
# National Cybersecurity Strategy 2025-2029). Do not weaken the protocol or cipher
# settings below; see docs/security/.

server {
    listen 80;
    server_name _;
    # Plain HTTP exists only to redirect.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;

    # Forms, concept ZIPs and attachments can be large.
    client_max_body_size 512m;

    location /openmrs/spa/ {
        proxy_pass http://frontend:80/openmrs/spa/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /openmrs/ {
        proxy_pass http://backend:8080/openmrs/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 300s;
    }

    location = / {
        return 302 /openmrs/spa/;
    }

    # Legacy admin UI. MOH ICT SOP control D5 keeps this off in production; dev and
    # staging turn it on to reach Manage Modules and the legacy scheduler, which have no
    # O3 equivalent yet. LEGACY_ADMIN_UI is true|false and defaults to false in the
    # Dockerfile, so an environment that never sets it stays blocked.
    #
    # An unrecognised value names a snippet that does not exist and nginx refuses to
    # start. That is deliberate: a typo must not quietly fall through to "allowed".
    include /etc/nginx/snippets/legacy-admin-${LEGACY_ADMIN_UI}.conf;
}
