/* Certificate login only, one domain per acceptor. Files are linked into etc by the entrypoint. */
sync {
   org.apache.activemq.artemis.spi.core.security.jaas.TextFileCertificateLoginModule required
       debug=false
       reload=true
       org.apache.activemq.jaas.textfiledn.user="cert-users.properties"
       org.apache.activemq.jaas.textfiledn.role="cert-roles.properties";
};

admin {
   org.apache.activemq.artemis.spi.core.security.jaas.TextFileCertificateLoginModule required
       debug=false
       reload=true
       org.apache.activemq.jaas.textfiledn.user="admin-cert-users.properties"
       org.apache.activemq.jaas.textfiledn.role="admin-cert-roles.properties";
};
