<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>lr.gov.moh.liberiaemr</groupId>
	<artifactId>liberiaemr</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<packaging>pom</packaging>

	<name>LiberiaEMR</name>
	<description>
		OpenMRS 3.x EMR for UNFPA Liberia and the Ministry of Health, Republic of Liberia. This aggregator builds the layered
		content packages; the deployable artefacts are assembled from distribution/.
	</description>
	<url>https://github.com/IntelliSOFT-Consulting/liberia-emr</url>

	<organization>
		<name>Ministry of Health, Republic of Liberia</name>
	</organization>

	<licenses>
		<license>
			<name>Mozilla Public License 2.0 with Healthcare Disclaimer</name>
			<url>http://license.openmrs.org</url>
		</license>
	</licenses>

	<scm>
		<connection>scm:git:git@github.com:IntelliSOFT-Consulting/liberia-emr.git</connection>
		<developerConnection>scm:git:git@github.com:IntelliSOFT-Consulting/liberia-emr.git</developerConnection>
		<url>https://github.com/IntelliSOFT-Consulting/liberia-emr</url>
		<tag>HEAD</tag>
	</scm>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<!--
			SonarQube java:S2143 ("use java.time") does not apply to these three files: java.util.Date is
			the reporting module's own parameter and value type, and what JDBC returns for a DATETIME
			column. The rule reports at file level, which @SuppressWarnings on a class does not reach,
			so the exclusion lives here, one entry per file. Any other file still gets the rule.
		-->
		<sonar.issue.ignore.multicriteria>s2143a,s2143b,s2143c</sonar.issue.ignore.multicriteria>
		<sonar.issue.ignore.multicriteria.s2143a.ruleKey>java:S2143</sonar.issue.ignore.multicriteria.s2143a.ruleKey>
		<sonar.issue.ignore.multicriteria.s2143a.resourceKey>**/liberiaemrreports/reporting/ReportParameters.java</sonar.issue.ignore.multicriteria.s2143a.resourceKey>
		<sonar.issue.ignore.multicriteria.s2143b.ruleKey>java:S2143</sonar.issue.ignore.multicriteria.s2143b.ruleKey>
		<sonar.issue.ignore.multicriteria.s2143b.resourceKey>**/liberiaemrreports/reporting/EtlSqlDataSetEvaluator.java</sonar.issue.ignore.multicriteria.s2143b.resourceKey>
		<sonar.issue.ignore.multicriteria.s2143c.ruleKey>java:S2143</sonar.issue.ignore.multicriteria.s2143c.ruleKey>
		<sonar.issue.ignore.multicriteria.s2143c.resourceKey>**/liberiaemrreports/context/ReportingContextService.java</sonar.issue.ignore.multicriteria.s2143c.resourceKey>
	</properties>

	<modules>
		<module>content-packages</module>
		<!--
			The MOH indicator reports OMOD (ADR 0010 decision 6). In the reactor so that `mvn verify`
			tests it and the dependency and SBOM scans see it; the backend image builds it from
			source in the Dockerfile module stage, never from this build's output.
		-->
		<module>modules/liberiaemrreports</module>
	</modules>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-release-plugin</artifactId>
				<version>3.1.1</version>
				<configuration>
					<autoVersionSubmodules>true</autoVersionSubmodules>
					<useReleaseProfile>false</useReleaseProfile>
					<releaseProfiles>release</releaseProfiles>
					<preparationGoals>clean install</preparationGoals>
					<goals>deploy</goals>
					<tagNameFormat>@{project.version}</tagNameFormat>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
